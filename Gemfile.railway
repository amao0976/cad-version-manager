# Railway 生产环境 Gemfile
# 在 Railway 上部署时，设置 BUNDLE_GEMFILE=Gemfile.railway

source "https://rubygems.org"

gem "rails", "~> 8.1.3"

# PostgreSQL for Railway production
gem "pg", "~> 1.1"

gem "puma", ">= 5.0"
gem "jbuilder"
gem "bcrypt", "~> 3.1.7"
gem "devise"
gem "jwt"
gem "pundit"
gem "active_model_serializers"
gem "tzinfo-data"
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"
gem "rack-cors"
gem "bootsnap", require: false
gem "kamal", require: false
gem "thruster", require: false
gem "image_processing", "~> 1.2"
gem "turbo-rails"
gem "stimulus-rails"
gem "importmap-rails"
gem "propshaft"
gem "rack-cors"
gem "webdav"
gem "caxlsx"
gem "roo", "~> 2.10"
gem "csv"
gem "prawn", "~> 2.5"
gem "prawn-table", "~> 0.2"
gem "aasm"
gem "pagy", "~> 9.4"
gem "redcarpet"
gem "rouge"
gem "sanitize"
gem "carrierwave"
gem "mini_magick"

# Rails Assets (required for production)
gem "sprockets-rails"
