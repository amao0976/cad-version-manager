<% content_for :title, '新建价格记录' %>

<div class="page-header">
  <h1>新建价格记录</h1>
  <%= link_to '返回列表', material_material_prices_path(@material), class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">价格记录信息</div>
  <div class="material-info">
    材质：<span><%= @material.name %></span> | 
    编码：<span><%= @material.code %></span> | 
    单位：<span><%= @material.unit %></span>
  </div>
  <% if @material_price.errors.any? %>
    <div class="alert alert-danger">
      <% @material_price.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: [@material, @material_price] do |f| %>
    <div class="mb-3">
      <%= f.label :effective_date, '生效日期', class: 'form-label'%>
      <%= f.date_field :effective_date, class: 'form-control', value: Date.today %>
    </div>
    <div class="mb-3">
      <%= f.label :price_per_unit, '单价', class: 'form-label'%>
      <%= f.text_field :price_per_unit, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :currency, '币种', class: 'form-label'%>
      <%= f.text_field :currency, class: 'form-control', value: 'CNY' %>
    </div>
    <div class="mb-3">
      <%= f.label :source, '来源', class: 'form-label'%>
      <%= f.text_field :source, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建价格记录', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>