<% content_for :title, "#{@material.name} - 价格列表" %>

<div class="page-header">
  <h1><%= @material.name %> - 价格列表</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回材质', material_path(@material), class: 'btn btn-outline-secondary' %>
    <%= link_to '新建价格记录', new_material_material_price_path(@material), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">价格历史</div>
  <div class="material-info">
    材质：<span><%= @material.name %></span> | 
    编码：<span><%= @material.code %></span> | 
    单位：<span><%= @material.unit %></span>
  </div>
  <% if @material_prices.empty? %>
    <p>暂无价格记录</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>日期</th>
        <th>单价</th>
        <th>币种</th>
        <th>来源</th>
        <th>操作</th>
      </tr>
      <% @material_prices.each do |price| %>
      <tr>
        <td><%= link_to price.effective_date.strftime('%Y-%m-%d'), material_price_path(price) %></td>
        <td><%= price.price_per_unit %></td>
        <td><%= price.currency %></td>
        <td><%= price.source || '-' %></td>
        <td>
          <%= link_to '查看', material_price_path(price), class: 'btn btn-sm' %>
          <%= button_to '删除', material_price_path(price), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>