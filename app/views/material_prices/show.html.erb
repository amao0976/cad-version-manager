<% content_for :title, '价格记录详情' %>

<div class="page-header">
  <h1>价格记录详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回价格列表', material_material_prices_path(@material_price.material), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">价格信息</div>
  <div class="info-row">
    <span class="info-label">材质:</span>
    <%= link_to @material_price.material.name, material_path(@material_price.material) %>
  </div>
  <div class="info-row">
    <span class="info-label">生效日期:</span>
    <%= @material_price.effective_date.strftime('%Y-%m-%d') %>
  </div>
  <div class="info-row">
    <span class="info-label">单价:</span>
    <%= @material_price.price_per_unit %>
  </div>
  <div class="info-row">
    <span class="info-label">币种:</span>
    <%= @material_price.currency %>
  </div>
  <div class="info-row">
    <span class="info-label">来源:</span>
    <%= @material_price.source || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @material_price.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>