<% content_for :title, 'CAD 设计图纸版本管理系统' %>

<div class="container text-center" style="margin-top: 100px;">
  <div class="card" style="display: inline-block; padding: 40px;">
    <h1>CAD 设计图纸版本管理系统</h1>
    <p>欢迎使用 NX/Solid Edge 设计图纸版本管理系统</p>
    <br>
    <% if user_signed_in? %>
      <a href="/dashboard" class="btn">进入系统</a>
      <%= link_to '退出登录', destroy_user_session_path, data: { turbo: false }, class: 'btn' %>
    <% else %>
      <%= link_to '登录', new_user_session_path, class: 'btn' %>
      <%= link_to '注册', new_user_registration_path, class: 'btn' %>
    <% end %>
  </div>
</div>
