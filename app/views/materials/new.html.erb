<% content_for :title, '新建材质' %>

<div class="page-header">
  <h1>新建材质</h1>
  <%= link_to '返回列表', materials_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">材质信息</div>
  <% if @material.errors.any? %>
    <div class="alert alert-danger">
      <% @material.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @material do |f| %>
    <div class="mb-3">
      <%= f.label :name, '名称', class: 'form-label'%>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :code, '编码', class: 'form-label'%>
      <%= f.text_field :code, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :kind, '类型', class: 'form-label'%>
      <%= f.text_field :kind, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :case_material_category_id, '表壳材质', class: 'form-label'%>
      <%= f.collection_select :case_material_category_id, @case_material_categories, :id, :name, { include_blank: '请选择表壳材质' }, class: 'form-select' %>
      <div class="form-text">零件或配件的表壳材质分类</div>
    </div>
    <div class="mb-3">
      <%= f.label :unit, '单位', class: 'form-label'%>
      <%= f.text_field :unit, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :density, '密度', class: 'form-label'%>
      <%= f.text_field :density, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :description, '描述', class: 'form-label'%>
      <%= f.text_area :description, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建材质', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>