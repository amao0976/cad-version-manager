<% content_for :title, '材质管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-gem"></i> 材质管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '新建材质', new_material_path, class: 'btn btn-primary' %>
  </div>
</div>

<% if @materials.empty? %>
  <div class="card">
    <div class="card-body">
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无材质数据</div>
      </div>
    </div>
  </div>
<% else %>
  <% @materials.each do |type, materials| %>
    <div class="card mb-4">
      <div class="card-header">
        <span>
          <% if type == 'metal' %>
            <i class="bi bi-braces"></i> 金属材质
          <% elsif type == 'gemstone' %>
            <i class="bi bi-gem"></i> 宝石材质
          <% elsif type == 'other' %>
            <i class="bi bi-circle"></i> 其他材质
          <% else %>
            <i class="bi bi-circle"></i> <%= type %>
          <% end %>
        </span>
        <span class="badge bg-primary"><%= materials.count %></span>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
          <thead>
            <tr>
              <th>名称</th>
              <th>编码</th>
              <th>单位</th>
              <th>密度</th>
              <th>当前价</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% materials.each do |material| %>
            <tr>
              <td><%= link_to material.name, material_path(material), class: 'fw-semibold' %></td>
              <td><%= material.code %></td>
              <td><%= material.unit %></td>
              <td><%= material.density || '-' %></td>
              <td>
                <% price = material.current_price %>
                <% if price %>
                  <span class="badge bg-success"><%= price %></span>
                <% else %>
                  -
                <% end %>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to '查看', material_path(material), class: 'btn btn-sm btn-outline-primary' %>
                  <%= link_to '编辑', edit_material_path(material), class: 'btn btn-sm btn-outline-warning' %>
                  <%= button_to '删除', material_path(material), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
                </div>
              </td>
            </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
