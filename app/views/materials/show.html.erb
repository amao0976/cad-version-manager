<% content_for :title, "#{@material.name} - 材质详情" %>

<div class="page-header">
  <h1><%= @material.name %> - 材质详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', materials_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_material_path(@material), class: 'btn btn-outline-secondary' %>
    <%= link_to '添加价格记录', new_material_material_price_path(@material), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">名称:</span>
    <%= @material.name %>
  </div>
  <div class="info-row">
    <span class="info-label">编码:</span>
    <%= @material.code %>
  </div>
  <div class="info-row">
    <span class="info-label">类型:</span>
    <%= case @material.kind when 'metal' then '金属' when 'gemstone' then '宝石' when 'other' then '其他' else @material.kind end %>
  </div>
  <div class="info-row">
    <span class="info-label">单位:</span>
    <%= @material.unit %>
  </div>
  <div class="info-row">
    <span class="info-label">密度:</span>
    <%= @material.density || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">当前价格:</span>
    <%= @material.latest_price ? "#{@material.latest_price.price_per_unit} #{@material.latest_price.currency}" : '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">描述:</span>
    <%= @material.description || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @material.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">价格历史</div>
  <% if @material.material_prices.empty? %>
    <p>暂无价格记录</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>日期</th>
        <th>单价</th>
        <th>币种</th>
        <th>来源</th>
        <th>操作</th>
      </tr>
      <% @material.material_prices.order(effective_date: :desc).each do |price| %>
      <tr>
        <td><%= link_to price.effective_date.strftime('%Y-%m-%d'), material_price_path(price) %></td>
        <td><%= price.price_per_unit %></td>
        <td><%= price.currency %></td>
        <td><%= price.source || '-' %></td>
        <td>
          <%= link_to '查看', material_price_path(price), class: 'btn btn-sm' %>
          <%= button_to '删除', material_price_path(price), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>