<% content_for :title, "编辑: #{@guide.title}" %>

<div class="page-header mb-4">
  <h1>编辑文档</h1>
  <%= link_to '返回详情', guide_path(@guide.slug), class: 'btn btn-outline-secondary' %>
</div>

<div class="row">
  <div class="col-lg-8">
    <%= form_with model: @guide, url: guide_path(@guide.slug), method: :patch, class: 'needs-validation' do |f| %>
      <div class="card">
        <div class="card-header fw-bold">基本信息</div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">标题 *</label>
            <%= f.text_field :title, class: 'form-control', required: true %>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">分类</label>
              <%= f.select :guide_category_id, options_from_collection_for_select(@categories, :id, :name, @guide.guide_category_id), { include_blank: '请选择分类' }, class: 'form-select' %>
            </div>
            <div class="col-md-6">
              <label class="form-label">关联产品（可选）</label>
              <%= f.select :product_id, options_from_collection_for_select(Product.order(:name), :id, :name, @guide.product_id), { include_blank: '不关联' }, class: 'form-select' %>
            </div>
          </div>

          <div class="mt-3">
            <label class="form-label">状态</label>
            <%= f.select :status, [['草稿', 'draft'], ['已发布', 'published'], ['已归档', 'archived']], {}, class: 'form-select' %>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header fw-bold">内容 (Markdown)</div>
        <div class="card-body">
          <%= f.text_area :content_md, class: 'form-control font-monospace', rows: 25, id: 'markdown-editor' %>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <%= f.submit '保存修改', class: 'btn btn-primary' %>
        <%= link_to '取消', guide_path(@guide.slug), class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header fw-bold">文档信息</div>
      <div class="card-body small">
        <p><strong>创建时间：</strong> <%= l(@guide.created_at, format: :short) %></p>
        <p><strong>最后更新：</strong> <%= l(@guide.updated_at, format: :short) %></p>
        <p><strong>阅读次数：</strong> <%= @guide.views_count %></p>
        <% if @guide.published_at %>
          <p><strong>发布时间：</strong> <%= l(@guide.published_at, format: :short) %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
