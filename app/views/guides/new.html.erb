<% content_for :title, '新建文档' %>

<div class="page-header mb-4">
  <h1>新建文档</h1>
  <%= link_to '返回列表', guides_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="row">
  <div class="col-lg-8">
    <%= form_with model: @guide, url: guides_path, method: :post, class: 'needs-validation' do |f| %>
      <div class="card">
        <div class="card-header fw-bold">基本信息</div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label">标题 *</label>
            <%= f.text_field :title, class: 'form-control', required: true, placeholder: '输入文档标题' %>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">分类</label>
              <%= f.select :guide_category_id, options_from_collection_for_select(@categories, :id, :name), { include_blank: '请选择分类' }, class: 'form-select' %>
            </div>
            <div class="col-md-6">
              <label class="form-label">关联产品（可选）</label>
              <%= f.select :product_id, options_from_collection_for_select(Product.order(:name), :id, :name), { include_blank: '不关联' }, class: 'form-select' %>
            </div>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header fw-bold">
          内容 (Markdown)
          <small class="text-muted">支持 Markdown 语法、代码高亮、表格等</small>
        </div>
        <div class="card-body">
          <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#editor-tab" type="button">编辑</button>
            </li>
            <li class="nav-item">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#preview-tab" type="button" id="preview-tab-btn">预览</button>
            </li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="editor-tab">
              <%= f.text_area :content_md, class: 'form-control font-monospace', rows: 20, placeholder: '用 Markdown 格式编写文档内容...', id: 'markdown-editor' %>
              <div class="mt-2 text-muted small">
                提示：支持 **粗体**、*斜体*、`代码`、[链接](url)、![图片](url)、列表、表格、代码块等
              </div>
            </div>
            <div class="tab-pane fade" id="preview-tab">
              <div id="preview-content" class="markdown-content border rounded p-3" style="min-height: 300px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <%= f.submit '保存为草稿', class: 'btn btn-secondary' %>
        <%= f.submit '保存并发布', class: 'btn btn-primary', name: 'publish' %>
        <%= link_to '取消', guides_path, class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header fw-bold">Markdown 快捷语法</div>
      <div class="card-body small">
        <table class="table table-sm">
          <thead>
            <tr><th>语法</th><th>效果</th></tr>
          </thead>
          <tbody>
            <tr><td>`**粗体**`</td><td><strong>粗体</strong></td></tr>
            <tr><td>`*斜体*`</td><td><em>斜体</em></td></tr>
            <tr><td>`- 列表项`</td><td>• 列表项</td></tr>
            <tr><td>`1. 有序项`</td><td>1. 有序项</td></tr>
            <tr><td>`` `代码` ``</td><td><code>代码</code></td></tr>
            <tr><td>`[链接](url)`</td><td><a href="#">链接</a></td></tr>
            <tr><td>`![图片](url)`</td><td>图片</td></tr>
            <tr><td>```代码块```</td><td>代码高亮</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  // 实时预览 Markdown
  document.getElementById('preview-tab-btn').addEventListener('click', function() {
    const content = document.getElementById('markdown-editor').value;
    // 简单预览 - 实际应用中可以使用 marked.js 等前端库
    document.getElementById('preview-content').textContent = '预览功能需要在服务器端渲染，请保存后查看。';
  });
</script>
