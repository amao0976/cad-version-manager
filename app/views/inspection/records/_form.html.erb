<%= form_with model: @record, url: @record.persisted? ? inspection_record_path(@record) : inspection_records_path do |f| %>
  <% if @record.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card mb-3">
    <div class="card-header fw-bold">基本信息</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :inspection_date, '验货日期', class: 'form-label' %>
            <%= f.date_field :inspection_date, class: 'form-control', required: true, id: 'inspection_date_field' %>
          </div>

          <div class="mb-3">
            <%= f.label :week, '周数', class: 'form-label' %>
            <%= f.number_field :week, min: 1, class: 'form-control', id: 'week_field', readonly: true %>
            <small class="text-muted">根据日期自动计算</small>
          </div>

          <div class="mb-3">
            <%= f.label :supplier_id, '供应商', class: 'form-label' %>
            <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: '请选择供应商' }, class: 'form-select', required: true, id: 'supplier_select' %>
            <small class="text-muted"><%= link_to '管理供应商', suppliers_path, style: 'color: var(--primary);' %></small>
          </div>

          <div class="mb-3">
            <%= f.label :factory_id, '工厂', class: 'form-label' %>
            <%= f.collection_select :factory_id, @factories, :id, :name, { include_blank: '请选择工厂' }, class: 'form-select', id: 'factory_select' %>
            <small class="text-muted"><%= link_to '管理工厂', factories_path, style: 'color: var(--primary);' %></small>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :country, '国家', class: 'form-label' %>
                <%= f.text_field :country, class: 'form-control', id: 'country_display', readonly: true %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :province, '省份', class: 'form-label' %>
                <%= f.text_field :province, class: 'form-control', id: 'province_display', readonly: true %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :order_no, '订单号', class: 'form-label' %>
            <%= f.text_field :order_no, class: 'form-control', required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :reference_no, '参考号', class: 'form-label' %>
            <%= f.text_field :reference_no, class: 'form-control', required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :inspection_type, '检验类型', class: 'form-label' %>
            <%= f.select :inspection_type, Inspection::Record::INSPECTION_TYPES, { include_blank: '请选择' }, class: 'form-select' %>
          </div>

          <div class="mb-3">
            <%= f.label :product_id, '关联产品', class: 'form-label' %>
            <%= f.collection_select :product_id, @products, :id, :name, { include_blank: '不关联' }, class: 'form-select' %>
          </div>

          <div class="mb-3">
            <%= f.label :inspection_request_id, '关联申请', class: 'form-label' %>
            <%= f.collection_select :inspection_request_id, @requests, :id, :order_number, { include_blank: '不关联' }, class: 'form-select' %>
          </div>

          <div class="mb-3">
            <%= f.label :city, '城市', class: 'form-label' %>
            <%= f.text_field :city, class: 'form-control', id: 'city_display', readonly: true %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header fw-bold">订单/产品信息</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :order_quantity, '订单数量', class: 'form-label' %>
            <%= f.number_field :order_quantity, min: 0, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :shipment_quantity, '出货数量', class: 'form-label' %>
            <%= f.number_field :shipment_quantity, min: 0, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :buyer, '买家', class: 'form-label' %>
            <%= f.text_field :buyer, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :fabric_name, '面料', class: 'form-label' %>
            <%= f.text_field :fabric_name, class: 'form-control' %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :set_name, '套装名称', class: 'form-label' %>
            <%= f.text_field :set_name, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :etd, 'ETD', class: 'form-label' %>
            <%= f.date_field :etd, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :transport, '运输方式', class: 'form-label' %>
            <%= f.select :transport, ['空运', '海运', '陆运', '快递'], { include_blank: '请选择' }, class: 'form-select' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :qc_name, '验货员', class: 'form-label' %>
            <%= f.text_field :qc_name, class: 'form-control' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header fw-bold">检验项目</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :physical_test, '物理测试', class: 'form-label' %>
            <%= f.select :physical_test, [['合格', 'YES'], ['不合格', 'NO']], { include_blank: '请选择' }, class: 'form-select' %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :chemical_test, '化学测试', class: 'form-label' %>
            <%= f.select :chemical_test, [['合格', 'YES'], ['不合格', 'NO']], { include_blank: '请选择' }, class: 'form-select' %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= f.label :rfid_checking, 'RFID检查', class: 'form-label' %>
            <%= f.select :rfid_checking, ['合格', '不合格', '未检查'], { include_blank: '请选择' }, class: 'form-select' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header fw-bold">缺陷与结果</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :major_defects, '主要缺陷', class: 'form-label' %>
            <%= f.number_field :major_defects, min: 0, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :minor_defects, '次要缺陷', class: 'form-label' %>
            <%= f.number_field :minor_defects, min: 0, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :qty_rejected, '拒收数量', class: 'form-label' %>
            <%= f.number_field :qty_rejected, min: 0, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="mb-3">
            <%= f.label :result, '检验结果', class: 'form-label' %>
            <%= f.select :result, Inspection::Record::RESULTS.to_a, { include_blank: '请选择' }, class: 'form-select' %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :ps_comments, '生产/采购部意见', class: 'form-label' %>
            <%= f.text_area :ps_comments, class: 'form-control', rows: 3 %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :comments, '备注', class: 'form-label' %>
            <%= f.text_area :comments, class: 'form-control', rows: 3 %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= f.hidden_field :country, id: 'country_hidden' %>
  <%= f.hidden_field :province, id: 'province_hidden' %>
  <%= f.hidden_field :city, id: 'city_hidden' %>
  <%= f.hidden_field :supplier_name, id: 'supplier_name_hidden' %>
  <%= f.hidden_field :factory_name, id: 'factory_name_hidden' %>

  <div class="mb-3">
    <%= f.submit @record.persisted? ? '保存' : '创建', class: 'btn btn-primary' %>
    <%= link_to '取消', @record.persisted? ? inspection_record_path(@record) : inspection_records_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>

<script>
(function() {
  var supplierSelect = document.getElementById("supplier_select");
  var factorySelect = document.getElementById("factory_select");
  var countryDisplay = document.getElementById("country_display");
  var provinceDisplay = document.getElementById("province_display");
  var cityDisplay = document.getElementById("city_display");
  var countryHidden = document.getElementById("country_hidden");
  var provinceHidden = document.getElementById("province_hidden");
  var cityHidden = document.getElementById("city_hidden");

  var factoryCache = {};
  var initialFactoryId = factorySelect ? factorySelect.value : null;

  function clearSelect(select, promptText) {
    select.innerHTML = "";
    var opt = document.createElement("option");
    opt.value = "";
    opt.textContent = promptText;
    select.appendChild(opt);
  }

  function loadFactories(supplierId) {
    if (!supplierId) {
      clearSelect(factorySelect, '请先选择供应商');
      clearLocation();
      return;
    }
    if (factoryCache[supplierId]) {
      populateFactories(factoryCache[supplierId]);
    } else {
      clearSelect(factorySelect, '加载中...');
      var xhr = new XMLHttpRequest();
      xhr.open("GET", "/suppliers/" + supplierId + "/factories");
      xhr.setRequestHeader("Accept", "application/json");
      xhr.onload = function() {
        if (xhr.status === 200) {
          var factories = JSON.parse(xhr.responseText);
          factoryCache[supplierId] = factories;
          populateFactories(factories);
        } else {
          clearSelect(factorySelect, '加载失败');
        }
      };
      xhr.send();
    }
  }

  function populateFactories(factories) {
    clearSelect(factorySelect, factories.length > 0 ? '请选择工厂' : '暂无工厂');
    factories.forEach(function(f) {
      var opt = document.createElement("option");
      opt.value = f.id;
      opt.textContent = f.name + "（" + [f.country, f.province, f.city].filter(Boolean).join("/") + "）";
      opt.dataset.country = f.country || "";
      opt.dataset.province = f.province || "";
      opt.dataset.city = f.city || "";
      factorySelect.appendChild(opt);
    });
    if (initialFactoryId) {
      factorySelect.value = initialFactoryId;
      initialFactoryId = null;
      updateLocation();
    }
  }

  function clearLocation() {
    if (countryDisplay) countryDisplay.value = "";
    if (provinceDisplay) provinceDisplay.value = "";
    if (cityDisplay) cityDisplay.value = "";
    if (countryHidden) countryHidden.value = "";
    if (provinceHidden) provinceHidden.value = "";
    if (cityHidden) cityHidden.value = "";
  }

  function updateLocation() {
    var selected = factorySelect.options[factorySelect.selectedIndex];
    if (!selected || !selected.value) {
      clearLocation();
      return;
    }
    var country = selected.dataset.country || "";
    var province = selected.dataset.province || "";
    var city = selected.dataset.city || "";

    if (countryDisplay) countryDisplay.value = country;
    if (provinceDisplay) provinceDisplay.value = province;
    if (cityDisplay) cityDisplay.value = city;
    if (countryHidden) countryHidden.value = country;
    if (provinceHidden) provinceHidden.value = province;
    if (cityHidden) cityHidden.value = city;
  }

  if (supplierSelect) {
    supplierSelect.addEventListener("change", function() {
      loadFactories(supplierSelect.value);
    });
  }

  if (factorySelect) {
    factorySelect.addEventListener("change", function() {
      updateLocation();
    });
  }

  if (supplierSelect && supplierSelect.value) {
    if (factorySelect.options.length > 1) {
      if (initialFactoryId) {
        factorySelect.value = initialFactoryId;
        initialFactoryId = null;
      }
      var xhr = new XMLHttpRequest();
      xhr.open("GET", "/suppliers/" + supplierSelect.value + "/factories");
      xhr.setRequestHeader("Accept", "application/json");
      xhr.onload = function() {
        if (xhr.status === 200) {
          var factories = JSON.parse(xhr.responseText);
          factoryCache[supplierSelect.value] = factories;
          factories.forEach(function(f) {
            for (var i = 0; i < factorySelect.options.length; i++) {
              if (factorySelect.options[i].value == f.id) {
                factorySelect.options[i].dataset.country = f.country || "";
                factorySelect.options[i].dataset.province = f.province || "";
                factorySelect.options[i].dataset.city = f.city || "";
              }
            }
          });
          updateLocation();
        }
      };
      xhr.send();
    } else {
      loadFactories(supplierSelect.value);
    }
  }

  var dateField = document.getElementById("inspection_date_field");
  var weekField = document.getElementById("week_field");

  function calcISOWeek(dateStr) {
    if (!dateStr) return "";
    var date = new Date(dateStr + "T00:00:00");
    if (isNaN(date.getTime())) return "";
    var tmpDate = new Date(date.valueOf());
    var dayNr = (date.getDay() + 6) % 7;
    tmpDate.setDate(tmpDate.getDate() - dayNr + 3);
    var firstThursday = tmpDate.valueOf();
    tmpDate.setMonth(0, 1);
    if (tmpDate.getDay() !== 4) {
      tmpDate.setMonth(0, 1 + ((4 - tmpDate.getDay()) + 7) % 7);
    }
    return 1 + Math.ceil((firstThursday - tmpDate) / 604800000);
  }

  if (dateField && weekField) {
    dateField.addEventListener("change", function() {
      var week = calcISOWeek(dateField.value);
      if (week) weekField.value = week;
    });
    if (dateField.value && !weekField.value) {
      var week = calcISOWeek(dateField.value);
      if (week) weekField.value = week;
    }
  }
})();
</script>