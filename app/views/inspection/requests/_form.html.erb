<%= form_with model: @request, url: @request.persisted? ? inspection_request_path(@request) : inspection_requests_path do |f| %>
  <% if @request.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @request.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card mb-3">
    <div class="card-header fw-bold">基本信息</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :supplier_id, '供应商', class: 'form-label' %>
            <% if current_user.supplier_role? %>
              <input type="text" class="form-control" value="<%= current_user.supplier&.name %>" readonly>
              <%= f.hidden_field :supplier_id, value: current_user.supplier_id %>
            <% else %>
              <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: '请选择供应商' }, class: 'form-select', required: true, id: 'supplier_select' %>
            <% end %>
          </div>

          <div class="mb-3">
            <%= f.label :factory_id, '工厂', class: 'form-label' %>
            <%= f.grouped_collection_select :factory_id, @suppliers.map { |s| [s.name, s.factories] }, :last, :first, :id, :name, { include_blank: '请选择工厂' }, class: 'form-select', id: 'factory_select' %>
          </div>

          <div class="mb-3">
            <%= f.label :product_id, '关联产品', class: 'form-label' %>
            <%= f.collection_select :product_id, @products, :id, :name, { include_blank: '不关联' }, class: 'form-select' %>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :order_number, '订单号', class: 'form-label' %>
            <%= f.text_field :order_number, class: 'form-control', required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :style_number, '款号', class: 'form-label' %>
            <%= f.text_field :style_number, class: 'form-control', required: true %>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :requested_date, '申请日期', class: 'form-label' %>
                <%= f.date_field :requested_date, class: 'form-control', required: true %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :inspection_type, '检验类型', class: 'form-label' %>
                <%= f.select :inspection_type, Inspection::Record::INSPECTION_TYPES, { include_blank: '请选择' }, class: 'form-select' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-bold">明细项（AQL自动计算）</span>
      <button type="button" class="btn btn-sm btn-outline-primary" id="add_item_btn">+ 添加项</button>
    </div>
    <div class="card-body table-responsive-wrap">
      <table class="table table-bordered" id="items_table">
        <thead>
          <tr>
            <th>订单号</th>
            <th>款号</th>
            <th>数量</th>
            <th>检验等级</th>
            <th>AQL水平</th>
            <th>代码字母</th>
            <th>抽样数</th>
            <th>接受数</th>
            <th>拒收数</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="items_body">
          <%= f.fields_for :items do |item_form| %>
            <%= render "item_row", item_form: item_form %>
          <% end %>
        </tbody>
      </table>
      <div style="font-size: 0.85rem; color: var(--muted);">
        AQL基于 ISO 2859-1 标准自动计算。修改数量或等级将自动更新结果。
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header fw-bold">备注</div>
    <div class="card-body">
      <%= f.text_area :remarks, class: 'form-control', rows: 3 %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.submit @request.persisted? ? '保存' : '创建', class: 'btn btn-primary' %>
    <%= link_to '取消', @request.persisted? ? inspection_request_path(@request) : inspection_requests_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>

<script type="text/html" id="new_item_template">
  <tr class="item-row">
    <td><input type="text" name="inspection_request[items_attributes][NEW_INDEX][order_number]" class="form-control form-control-sm item-order-number" placeholder="订单号" required></td>
    <td><input type="text" name="inspection_request[items_attributes][NEW_INDEX][style_number]" class="form-control form-control-sm item-style-number" placeholder="款号" required></td>
    <td><input type="number" name="inspection_request[items_attributes][NEW_INDEX][quantity]" class="form-control form-control-sm item-quantity" min="1" placeholder="数量" required oninput="calcAql(this)"></td>
    <td>
      <select name="inspection_request[items_attributes][NEW_INDEX][inspection_level]" class="form-select form-select-sm item-inspection-level" onchange="calcAql(this)">
        <% AqlCalculator::INSPECTION_LEVELS.each do |l| %>
          <option value="<%= l %>"><%= AqlCalculator::INSPECTION_LEVEL_LABELS[l] || l %></option>
        <% end %>
      </select>
    </td>
    <td>
      <select name="inspection_request[items_attributes][NEW_INDEX][aql_level]" class="form-select form-select-sm item-aql-level" onchange="calcAql(this)">
        <% AqlCalculator::AQL_LEVELS.each do |l| %>
          <option value="<%= l %>"<%= ' selected' if l == '2.5' %>><%= l %></option>
        <% end %>
      </select>
    </td>
    <td class="item-code-letter" style="text-align: center; font-weight: 600;">-</td>
    <td class="item-sample-size" style="text-align: center; font-weight: 600;">-</td>
    <td class="item-accept-qty" style="text-align: center; color: #16a34a; font-weight: 600;">-</td>
    <td class="item-reject-qty" style="text-align: center; color: #dc2626; font-weight: 600;">-</td>
    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)" title="删除">&times;</button></td>
  </tr>
</script>

<script>
var AQL_LOT_RANGES = [
  {min:2, max:8, l1:"A", l2:"A", l3:"B"},
  {min:9, max:15, l1:"A", l2:"B", l3:"C"},
  {min:16, max:25, l1:"B", l2:"C", l3:"D"},
  {min:26, max:50, l1:"C", l2:"D", l3:"E"},
  {min:51, max:90, l1:"D", l2:"E", l3:"F"},
  {min:91, max:150, l1:"E", l2:"F", l3:"G"},
  {min:151, max:280, l1:"F", l2:"G", l3:"H"},
  {min:281, max:500, l1:"G", l2:"H", l3:"J"},
  {min:501, max:1200, l1:"H", l2:"J", l3:"K"},
  {min:1201, max:3200, l1:"J", l2:"K", l3:"L"},
  {min:3201, max:10000, l1:"K", l2:"L", l3:"M"},
  {min:10001, max:35000, l1:"L", l2:"M", l3:"N"},
  {min:35001, max:150000, l1:"M", l2:"N", l3:"P"},
  {min:150001, max:500000, l1:"N", l2:"P", l3:"Q"},
  {min:500001, max:Infinity, l1:"P", l2:"Q", l3:"Q"}
];

var AQL_SAMPLE_SIZES = {
  A:2, B:3, C:5, D:8, E:13, F:20, G:32, H:50,
  J:80, K:125, L:200, M:315, N:500, P:800, Q:1250
};

var AQL_TABLE = {
  "1.0": {A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[1,2],H:[1,2],J:[2,3],K:[3,4],L:[5,6],M:[7,8],N:[10,11],P:[10,11],Q:[10,11]},
  "1.5": {A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[1,2],G:[1,2],H:[2,3],J:[3,4],K:[5,6],L:[7,8],M:[10,11],N:[14,15],P:[14,15],Q:[14,15]},
  "2.5": {A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[1,2],F:[1,2],G:[2,3],H:[3,4],J:[5,6],K:[7,8],L:[10,11],M:[14,15],N:[21,22],P:[21,22],Q:[21,22]},
  "4.0": {A:[0,1],B:[0,1],C:[1,2],D:[1,2],E:[1,2],F:[2,3],G:[3,4],H:[5,6],J:[7,8],K:[10,11],L:[14,15],M:[21,22],N:[21,22],P:[21,22],Q:[21,22]}
};

function getCodeLetter(lotSize, level) {
  if (!lotSize || lotSize < 1) return null;
  var r = AQL_LOT_RANGES.find(function(r) { return lotSize >= r.min && lotSize <= r.max; });
  if (!r) return null;
  if (level === "I") return r.l1;
  if (level === "III") return r.l3;
  return r.l2;
}

function calcAqlRow(row) {
  var qtyInput = row.querySelector(".item-quantity");
  var aqlSelect = row.querySelector(".item-aql-level");
  var levelSelect = row.querySelector(".item-inspection-level");
  var clCell = row.querySelector(".item-code-letter");
  var ssCell = row.querySelector(".item-sample-size");
  var acCell = row.querySelector(".item-accept-qty");
  var reCell = row.querySelector(".item-reject-qty");

  var qty = parseInt(qtyInput ? qtyInput.value : 0);
  var aql = aqlSelect ? aqlSelect.value : "2.5";
  var level = levelSelect ? levelSelect.value : "II";

  if (!qty || qty < 1) {
    clCell.textContent = "-";
    ssCell.textContent = "-";
    acCell.textContent = "-";
    reCell.textContent = "-";
    return;
  }

  var cl = getCodeLetter(qty, level);
  if (!cl) {
    clCell.textContent = "-";
    ssCell.textContent = "-";
    acCell.textContent = "-";
    reCell.textContent = "-";
    return;
  }

  var ss = AQL_SAMPLE_SIZES[cl];
  var table = AQL_TABLE[aql] || AQL_TABLE["2.5"];
  var ar = table[cl] || [0, 1];

  clCell.textContent = cl;
  ssCell.textContent = ss;
  acCell.textContent = ar[0];
  reCell.textContent = ar[1];
}

function calcAql(element) {
  var row = element.closest(".item-row");
  if (row) calcAqlRow(row);
}

function removeRow(button) {
  var row = button.closest(".item-row");
  var destroyField = row.querySelector("input[name*='[_destroy]']");
  if (destroyField) {
    destroyField.value = "1";
    row.style.display = "none";
  } else {
    row.remove();
  }
}

document.getElementById("add_item_btn").addEventListener("click", function() {
  var template = document.getElementById("new_item_template").innerHTML;
  var timestamp = new Date().getTime();
  var html = template.replace(/NEW_INDEX/g, timestamp);
  var tbody = document.getElementById("items_body");
  var tempDiv = document.createElement("div");
  tempDiv.innerHTML = "<table><tbody>" + html + "</tbody></table>";
  var newRow = tempDiv.querySelector("tr");
  tbody.appendChild(newRow);
});

document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll(".item-row").forEach(function(row) {
    calcAqlRow(row);
  });
});

(function() {
  var supplierSelect = document.getElementById("supplier_select");
  var factorySelect = document.getElementById("factory_select");
  if (!supplierSelect) return;

  var factoryCache = {};
  var initialFactoryId = factorySelect ? factorySelect.value : null;

  function loadFactories(supplierId) {
    if (!supplierId) {
      clearSelect(factorySelect, '请先选择供应商');
      return;
    }
    if (factoryCache[supplierId]) {
      populateFactories(factoryCache[supplierId]);
    } else {
      clearSelect(factorySelect, '加载中...');
      var xhr = new XMLHttpRequest();
      xhr.open("GET", "/suppliers/" + supplierId + "/factories");
      xhr.setRequestHeader("Accept", "application/json");
      xhr.onload = function() {
        if (xhr.status === 200) {
          var factories = JSON.parse(xhr.responseText);
          factoryCache[supplierId] = factories;
          populateFactories(factories);
        }
      };
      xhr.send();
    }
  }

  function clearSelect(select, promptText) {
    select.innerHTML = '';
    var opt = document.createElement("option");
    opt.value = "";
    opt.textContent = promptText;
    select.appendChild(opt);
  }

  function populateFactories(factories) {
    clearSelect(factorySelect, factories.length > 0 ? '请选择工厂' : '暂无工厂');
    factories.forEach(function(f) {
      var o = document.createElement("option");
      o.value = f.id;
      o.textContent = f.name;
      factorySelect.appendChild(o);
    });
    if (initialFactoryId) {
      factorySelect.value = initialFactoryId;
      initialFactoryId = null;
    }
  }

  supplierSelect.addEventListener("change", function() {
    loadFactories(supplierSelect.value);
  });

  if (supplierSelect.value && factorySelect && factorySelect.options.length <= 1) {
    loadFactories(supplierSelect.value);
  }
})();
</script>