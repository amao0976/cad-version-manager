<% content_for :title, '项目列表' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-folder2-open"></i> 项目列表</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> 项目列表</span>
    <span class="text-muted" style="font-size: 0.85rem;">共 <%= @design_projects.count %> 条</span>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>名称</th>
          <th>状态</th>
          <th>图纸数</th>
          <th>创建时间</th>
        </tr>
      </thead>
      <tbody>
        <% @design_projects.each do |project| %>
        <tr>
          <td><%= link_to project.name, design_project_path(project), class: 'fw-semibold' %></td>
          <td><span class="badge bg-secondary"><%= project.status %></span></td>
          <td><span class="badge bg-primary"><%= project.design_drawings.count %></span></td>
          <td><%= project.created_at.strftime('%Y-%m-%d') %></td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
