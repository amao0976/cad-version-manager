<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm mt-5">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="bi bi-box-seam-fill" style="font-size: 3rem; color: #2563eb;"></i>
          <h2 class="mt-2 mb-1">CAD 管理系统</h2>
          <p class="text-muted">请登录以继续</p>
        </div>

        <%= form_with scope: :user, url: user_session_path, method: :post, data: { turbo: false } do |f| %>
          <div class="mb-3">
            <label class="form-label">邮箱</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-envelope"></i></span>
              <%= f.email_field :email, class: 'form-control', autofocus: true, autocomplete: 'email', placeholder: 'your@email.com' %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">密码</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock"></i></span>
              <%= f.password_field :password, class: 'form-control', autocomplete: 'current-password', placeholder: '请输入密码' %>
            </div>
          </div>

          <div class="mb-3 form-check">
            <%= f.check_box :remember_me, class: 'form-check-input' %>
            <label class="form-check-label">记住我</label>
          </div>

          <%= f.submit '登录', class: 'btn btn-primary w-100 mb-3' %>
        <% end %>

        <div class="text-center">
          <%= link_to '还没有账号？注册', new_user_registration_path, class: 'text-decoration-none' %>
        </div>
      </div>
    </div>
  </div>
</div>
