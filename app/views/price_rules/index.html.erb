<% content_for :title, '定价规则管理' %>

<div class="page-header">
  <h1>定价规则管理</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '新建定价规则', new_price_rule_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">定价规则列表</div>
  <% if @price_rules.empty? %>
    <p>暂无定价规则数据</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>名称</th>
        <th>分类</th>
        <th>材质</th>
        <th>工费</th>
        <th>加价率</th>
        <th>生效日期</th>
        <th>失效日期</th>
        <th>启用</th>
        <th>操作</th>
      </tr>
      <% @price_rules.each do |rule| %>
      <tr>
        <td><%= link_to rule.name, price_rule_path(rule) %></td>
        <td><%= rule.category&.name || '全部' %></td>
        <td><%= rule.material&.name || '全部' %></td>
        <td><%= rule.labor_cost ? "#{rule.labor_cost}" : '-' %></td>
        <td><%= rule.markup_rate ? "#{(rule.markup_rate * 100).round(1)}%" : '-' %></td>
        <td><%= rule.effective_from&.strftime('%Y-%m-%d') || '-' %></td>
        <td><%= rule.effective_to&.strftime('%Y-%m-%d') || '-' %></td>
        <td><%= rule.active ? '<span class="status-active">是</span>' : '<span class="status-inactive">否</span>' %></td>
        <td>
          <%= link_to '查看', price_rule_path(rule), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_price_rule_path(rule), class: 'btn btn-sm' %>
          <%= button_to '删除', price_rule_path(rule), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>