<% content_for :title, '新建定价规则' %>

<div class="page-header">
  <h1>新建定价规则</h1>
  <%= link_to '返回列表', price_rules_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">定价规则信息</div>
  <% if @price_rule.errors.any? %>
    <div class="alert alert-danger">
      <% @price_rule.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @price_rule do |f| %>
    <div class="mb-3">
      <%= f.label :name, '名称', class: 'form-label'%>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :category_id, '适用分类', class: 'form-label'%>
      <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: '全部分类' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :material_id, '适用材质', class: 'form-label'%>
      <%= f.collection_select :material_id, @materials, :id, :name, { include_blank: '全部材质' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :labor_cost, '工费', class: 'form-label'%>
      <%= f.text_field :labor_cost, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :markup_rate, '加价率', class: 'form-label'%>
      <%= f.text_field :markup_rate, class: 'form-control' %>
      <div class="form-hint">小数形式，例如 0.5 表示 50%</div>
    </div>
    <div class="mb-3">
      <%= f.label :effective_from, '生效日期', class: 'form-label'%>
      <%= f.date_field :effective_from, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :effective_to, '失效日期', class: 'form-label'%>
      <%= f.date_field :effective_to, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :active, '启用', class: 'form-label'%>
      <%= f.check_box :active, class: 'form-check-input' %>
    </div>
    <div class="mb-3">
      <%= f.label :remark, '备注', class: 'form-label'%>
      <%= f.text_area :remark, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建定价规则', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>