<% content_for :title, "#{@price_rule.name} - 定价规则详情" %>

<div class="page-header">
  <h1><%= @price_rule.name %> - 定价规则详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', price_rules_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_price_rule_path(@price_rule), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">名称:</span>
    <%= @price_rule.name %>
  </div>
  <div class="info-row">
    <span class="info-label">适用分类:</span>
    <%= @price_rule.category&.name || '全部分类' %>
  </div>
  <div class="info-row">
    <span class="info-label">适用材质:</span>
    <%= @price_rule.material&.name || '全部材质' %>
  </div>
  <div class="info-row">
    <span class="info-label">工费:</span>
    <%= @price_rule.labor_cost ? "#{@price_rule.labor_cost}" : '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">加价率:</span>
    <%= @price_rule.markup_rate ? "#{(@price_rule.markup_rate * 100).round(1)}%" : '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">生效日期:</span>
    <%= @price_rule.effective_from&.strftime('%Y-%m-%d') || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">失效日期:</span>
    <%= @price_rule.effective_to&.strftime('%Y-%m-%d') || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">启用:</span>
    <%= @price_rule.active ? '<span class="status-active">是</span>' : '<span class="status-inactive">否</span>' %>
  </div>
  <div class="info-row">
    <span class="info-label">备注:</span>
    <%= @price_rule.remark || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @price_rule.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>