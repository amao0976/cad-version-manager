<% content_for :title, '编辑图纸' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-pencil-square"></i> 编辑图纸</h1>
    <div class="text-muted mt-1">
      <code><%= @drawing.display_drawing_code %></code>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回图纸详情', design_drawing_path(@drawing), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="bi bi-file-earmark-blueprint"></i> 图纸信息</div>
  <div class="card-body">
    <% if @drawing.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @drawing.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @drawing, url: design_drawing_path(@drawing), method: :patch) do |f| %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">图纸编号</label>
          <%= f.text_field :drawing_code, placeholder: '图纸编号', class: 'form-control' %>
          <div class="form-text">唯一标识图纸的编号，格式如 DWG-0001</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">图纸名称 *</label>
          <%= f.text_field :name, placeholder: '图纸名称', class: 'form-control', required: true %>
        </div>
        <div class="col-md-6">
          <label class="form-label">所属项目 *</label>
          <%= f.select :design_project_id, @projects.map { |p| [p.name, p.id] }, include_blank: '请选择项目', class: 'form-select' %>
        </div>
        <div class="col-md-6">
          <label class="form-label">文件类型 *</label>
          <%= f.select :file_type, DesignDrawing.file_types.map { |k, v| [v, k] }, include_blank: '请选择类型', class: 'form-select' %>
        </div>
        <div class="col-12">
          <label class="form-label">描述</label>
          <%= f.text_area :description, placeholder: '图纸描述', class: 'form-control', rows: 3 %>
        </div>
        <div class="col-12">
          <div class="d-flex gap-2">
            <%= f.submit '保存修改', class: 'btn btn-primary' %>
            <%= link_to '取消', design_drawing_path(@drawing), class: 'btn btn-outline-secondary' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
