<% content_for :title, '新建图纸' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-plus-circle"></i> 新建图纸</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回列表', design_drawings_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="bi bi-file-earmark-blueprint"></i> 图纸信息</div>
  <div class="card-body">
    <% if @drawing.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @drawing.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @drawing, url: design_drawings_path, method: :post, multipart: true) do |f| %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">图纸编号</label>
          <%= f.text_field :drawing_code, placeholder: '留空自动生成 (如 DWG-0001)', class: 'form-control' %>
          <div class="form-text">留空将自动生成编号，格式为 DWG-XXXX</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">图纸名称 *</label>
          <%= f.text_field :name, placeholder: '图纸名称', class: 'form-control', required: true %>
        </div>
        <div class="col-md-6">
          <label class="form-label">所属项目 *</label>
          <%= f.select :design_project_id, @projects.map { |p| [p.name, p.id] }, include_blank: '请选择项目', class: 'form-select' %>
        </div>
        <div class="col-md-6">
          <label class="form-label">文件类型 *</label>
          <%= f.select :file_type, DesignDrawing.file_types.map { |k, v| [v, k] }, include_blank: '请选择类型', class: 'form-select' %>
        </div>
        <div class="col-12">
          <label class="form-label">描述</label>
          <%= f.text_area :description, placeholder: '图纸描述', class: 'form-control', rows: 3 %>
        </div>
        <div class="col-12">
          <label class="form-label">上传图纸文件（可选）</label>
          <%= f.file_field :file, class: 'form-control' %>
          <div class="form-text">支持格式: .prt, .asm, .dft, .dwg, .step, .iges, .stl</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">初始版本类型</label>
          <%= select_tag :version_type, options_for_select([['草稿版本 (00, 01, 02...)', 'draft'], ['正式版本 (A, B, C...)', 'formal']], 'draft'), class: 'form-select' %>
          <div class="form-text">草稿版本用于迭代设计，正式版本用于发布归档</div>
        </div>
        <div class="col-12">
          <div class="d-flex gap-2">
            <%= f.submit '创建图纸', class: 'btn btn-primary' %>
            <%= link_to '取消', design_drawings_path, class: 'btn btn-outline-secondary' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
