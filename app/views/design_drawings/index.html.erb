<% content_for :title, '图纸管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-file-earmark-blueprint"></i> 图纸管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '新建图纸', new_design_drawing_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-4 search-card">
  <div class="card-body">
    <div class="section-title"><i class="bi bi-search"></i> 搜索筛选</div>
    <%= form_with url: design_drawings_path, method: :get, data: { turbo_action: :advance } do %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label">关键词</label>
          <%= text_field_tag :keyword, params[:keyword], placeholder: '图纸编号/名称', class: 'form-control' %>
        </div>
        <div class="col-md-3">
          <label class="form-label">项目</label>
          <%= select_tag :project_id, options_from_collection_for_select(@projects, :id, :name, params[:project_id]), include_blank: '全部项目', class: 'form-select' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">文件类型</label>
          <%= select_tag :file_type, options_for_select([['全部类型', '']] + @file_types.map { |k, v| [v, k] }, params[:file_type]), class: 'form-select' %>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <%= submit_tag '搜索', class: 'btn btn-primary flex-fill' %>
          <%= link_to '重置', design_drawings_path, class: 'btn btn-outline-secondary' %>
        </div>
      </div>
    <% end %>
    <div class="mt-2 text-muted" style="font-size: 0.85rem;">共 <strong><%= @drawings.count %></strong> 条记录</div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> 图纸列表</span>
  </div>
  <div class="card-body p-0">
    <% if @drawings.empty? %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无图纸数据</div>
      </div>
    <% else %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>图纸编号</th>
            <th>名称</th>
            <th>项目</th>
            <th>类型</th>
            <th>最新版本</th>
            <th>版本数</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @drawings.each do |drawing| %>
          <% latest = drawing.latest_version %>
          <tr>
            <td><code><%= drawing.display_drawing_code %></code></td>
            <td><%= link_to drawing.name, design_drawing_path(drawing), class: 'fw-semibold' %></td>
            <td><%= drawing.design_project&.name || '-' %></td>
            <td><span class="badge bg-info text-dark"><%= drawing.file_type.upcase %></span></td>
            <td>
              <% if latest %>
                <% if latest.is_formal? %>
                  <span class="badge badge-released">正式 V<%= latest.version_label %></span>
                <% else %>
                  <span class="badge badge-draft">草稿 <%= latest.version_label %></span>
                <% end %>
              <% else %>
                -
              <% end %>
            </td>
            <td><span class="badge bg-primary"><%= drawing.drawing_versions.count %></span></td>
            <td>
              <div class="d-flex gap-1 flex-wrap">
                <%= link_to '查看', design_drawing_path(drawing), class: 'btn btn-sm btn-outline-primary' %>
                <%= link_to '上传版本', design_drawing_upload_version_path(drawing), class: 'btn btn-sm btn-outline-info' %>
                <%= link_to '编辑', edit_design_drawing_path(drawing), class: 'btn btn-sm btn-outline-warning' %>
                <%= button_to '删除', design_drawing_path(drawing), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
