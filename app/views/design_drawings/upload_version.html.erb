<% content_for :title, '上传图纸版本' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-upload"></i> 上传图纸版本</h1>
    <div class="text-muted mt-1">
      <code><%= @drawing.display_drawing_code %></code>
      <span class="mx-2">·</span>
      <span><%= @drawing.name %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回图纸详情', design_drawing_path(@drawing), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="stat-card" style="--stat-from: #64748b; --stat-to: #475569;">
      <div class="stat-number"><%= @drawing.drawing_versions.count %></div>
      <div class="stat-label">版本总数</div>
      <i class="bi bi-stack stat-icon"></i>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card" style="--stat-from: #10b981; --stat-to: #059669;">
      <div class="stat-number"><%= @drawing.latest_formal ? "V#{@drawing.latest_formal.version_label}" : '-' %></div>
      <div class="stat-label">最新正式版</div>
      <i class="bi bi-patch-check stat-icon"></i>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card" style="--stat-from: #f59e0b; --stat-to: #d97706;">
      <div class="stat-number"><%= @drawing.latest_draft ? @drawing.latest_draft.version_label : '-' %></div>
      <div class="stat-label">最新草稿版</div>
      <i class="bi bi-pencil-square stat-icon"></i>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card" style="--stat-from: #3b82f6; --stat-to: #1d4ed8;">
      <div class="stat-number"><%= @drawing.design_project&.name || '-' %></div>
      <div class="stat-label">所属项目</div>
      <i class="bi bi-folder stat-icon"></i>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="bi bi-cloud-upload"></i> 上传新版本</div>
  <div class="card-body">
    <% if flash[:alert] %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= flash[:alert] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <%= form_with(url: design_drawing_create_version_path(@drawing), method: :post, multipart: true) do |f| %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">版本类型</label>
          <%= select_tag :version_type, options_for_select([['草稿版本 (00, 01, 02...)', 'draft'], ['正式版本 (A, B, C...)', 'formal']], 'draft'), class: 'form-select' %>
          <div class="form-text">草稿版本用于迭代设计，正式版本用于发布归档</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">选择图纸文件</label>
          <%= f.file_field :file, class: 'form-control' %>
          <div class="form-text">支持格式: .prt, .asm, .dft, .dwg, .step, .iges, .stl</div>
        </div>
        <div class="col-12">
          <label class="form-label">变更日志</label>
          <%= f.text_area :change_log, placeholder: '描述本次版本变更内容...', class: 'form-control', rows: 3 %>
        </div>
        <div class="col-12">
          <div class="d-flex gap-2">
            <%= f.submit '上传版本', class: 'btn btn-primary' %>
            <%= link_to '取消', design_drawing_path(@drawing), class: 'btn btn-outline-secondary' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
