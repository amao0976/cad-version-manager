<% content_for :title, "#{@product.name} - 产品详情" %>

<div class="page-header">
  <h1><%= @product.name %> - 产品详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', products_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_product_path(@product), class: 'btn btn-outline-secondary' %>
    <%= link_to 'PLM视图', plm_dashboard_path, class: 'btn btn-outline-info' %>
    <%= link_to '计算价格', calculate_price_product_path(@product), class: 'btn btn-success' %>
  </div>
</div>

<!-- 生命周期状态 -->
<div class="card mb-4">
  <div class="card-header fw-bold">产品生命周期</div>
  <div class="card-body">
    <div class="d-flex align-items-center justify-content-center flex-wrap gap-2 mb-3">
      <% Product.lifecycle_states.each_with_index do |(label, state), index| %>
        <% if index > 0 %>
          <span class="text-muted fs-4">→</span>
        <% end %>
        <% active = @product.lifecycle_state == state %>
        <% passed = Product.lifecycle_states.values.index(@product.lifecycle_state) > index rescue false %>
        <span class="badge p-2 <%= active ? 'bg-primary' : (passed ? 'bg-success' : 'bg-light text-muted border') %>">
          <%= label %>
        </span>
      <% end %>
    </div>

    <% if @product.allowed_next_states.any? %>
      <div class="text-center">
        <span class="text-muted me-2">状态转换：</span>
        <% @product.allowed_next_states.each do |next_state| %>
          <%= button_to Product.lifecycle_states.key(next_state),
                transition_product_path(@product, to_state: next_state),
                method: :post,
                class: 'btn btn-sm btn-outline-primary me-2',
                data: { turbo_confirm: "确认将产品状态变更为「#{Product.lifecycle_states.key(next_state)}」？" } %>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-muted">该状态为终态，不可再转换</p>
    <% end %>
  </div>
</div>

<!-- 生命周期时间线 -->
<div class="card mb-4">
  <div class="card-header fw-bold">生命周期时间线</div>
  <div class="card-body">
    <% histories = @product.lifecycle_histories.includes(:changed_by).order(created_at: :desc) %>
    <% if histories.any? %>
      <div class="timeline">
        <% histories.each do |h| %>
          <div class="timeline-item">
            <div class="timeline-badge bg-<%= h.to_state == 'obsolete' ? 'danger' : 'primary' %>"></div>
            <div class="timeline-content">
              <strong><%= h.from_state_label || '初始' %></strong>
              →
              <strong><%= h.to_state_label %></strong>
              <br>
              <small class="text-muted">
                <%= h.changed_by&.email || '系统' %> ·
                <%= l(h.created_at, format: :long) %>
              </small>
              <% if h.remark.present? %>
                <br><small><%= h.remark %></small>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">暂无生命周期变更记录</p>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">产品编码:</span>
    <%= @product.product_code %>
  </div>
  <div class="info-row">
    <span class="info-label">名称:</span>
    <%= @product.name %>
  </div>
  <div class="info-row">
    <span class="info-label">分类:</span>
    <%= @product.category&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">机芯类型:</span>
    <%= @product.movement_category&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">表带类型:</span>
    <%= @product.strap_category&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">目标人群:</span>
    <%= @product.target_group_category&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">产品主题:</span>
    <% if @product.theme.present? %>
      <span class="badge bg-warning text-dark"><%= @product.theme_label %></span>
    <% else %>
      -
    <% end %>
  </div>
  <div class="info-row">
    <span class="info-label">基础克重:</span>
    <%= @product.base_weight ? "#{@product.base_weight}g" : '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">设计图:</span>
    <%= @product.design_drawing&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">发布状态:</span>
    <span class="status-<%= @product.status %>"><%= case @product.status when 'draft' then '草稿' when 'published' then '已发布' when 'offline' then '已下架' end %></span>
  </div>
  <div class="info-row">
    <span class="info-label">描述:</span>
    <%= @product.description || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @product.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>

<%# 产品图片展示区 %>
<% images = @product.product_images.sorted %>
<% if images.any? %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-bold"><i class="bi bi-images"></i> 产品图片 (<%= images.count %>)</span>
      <%= link_to '管理图片', edit_product_path(@product, anchor: 'productImageRows'), class: 'btn btn-sm btn-outline-primary' %>
    </div>
    <div class="card-body">
      <div class="image-gallery">
        <% images.each do |pimg| %>
          <div class="gallery-item <%= 'is-cover' if pimg.is_cover? %>">
            <a href="<%= pimg.image.url %>" class="product-thumb d-block" data-bs-toggle="lightbox" data-bs-title="<%= @product.name %>" onclick="lb_open(this.href, this.dataset.bsTitle); return false;">
              <img src="<%= pimg.image.url %>"
                   data-full="<%= pimg.image.url %>"
                   alt="<%= @product.name %> - 图片"
                   loading="lazy"
                   style="max-width: 100%; height: auto; object-fit: cover;">
            </a>
          </div>
        <% end %>
      </div>
      <div class="form-text mt-2">点击任意图片可查看完整大图</div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header fw-bold">BOM列表</div>
  <% if @product_boms.empty? %>
    <p>暂无BOM</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>名称</th>
        <th>版本</th>
        <th>状态</th>
        <th>物料数量</th>
        <th>创建时间</th>
        <th>操作</th>
      </tr>
      <% @product_boms.each do |bom| %>
      <tr>
        <td><%= link_to bom.name, bom_path(bom) %></td>
        <td><%= bom.revision %></td>
        <td><span class="status-<%= bom.status %>"><%= case bom.status when 'draft' then '草稿' when 'approved' then '已审批' when 'released' then '已发布' when 'archived' then '已归档' end %></span></td>
        <td><%= bom.bom_items.count %></td>
        <td><%= bom.created_at.strftime('%Y-%m-%d') %></td>
        <td>
          <%= link_to '查看', bom_path(bom), class: 'btn btn-sm' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="card-header fw-bold">变体列表</div>
  <div class="d-flex gap-2 mb-3" style="margin-bottom: 15px;">
    <%= link_to '新建变体', new_product_variant_path(@product), class: 'btn btn-outline-secondary' %>
  </div>
  <% if @product.variants.empty? %>
    <p>暂无变体</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>SKU编码</th>
        <th>材质</th>
        <th>尺寸</th>
        <th>颜色</th>
        <th>宝石</th>
        <th>重量</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
      <% @product.variants.each do |variant| %>
      <tr>
        <td><%= link_to variant.sku_code, product_variant_path(@product, variant) %></td>
        <td><%= variant.material&.name || '-' %></td>
        <td><%= variant.size || '-' %></td>
        <td><%= variant.color || '-' %></td>
        <td><%= variant.gemstone || '-' %></td>
        <td><%= variant.weight ? "#{variant.weight}g" : '-' %></td>
        <td><span class="status-<%= variant.status %>"><%= case variant.status when 'active' then '启用' when 'inactive' then '停用' end %></span></td>
        <td>
          <%= link_to '查看', product_variant_path(@product, variant), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_product_variant_path(@product, variant), class: 'btn btn-sm' %>
          <%= button_to '删除', product_variant_path(@product, variant), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="card-header fw-bold">批次列表</div>
  <% if @batches.empty? %>
    <p>暂无批次</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>批次号</th>
        <th>变体</th>
        <th>数量</th>
        <th>生产日期</th>
        <th>状态</th>
        <th>序列号数</th>
        <th>操作</th>
      </tr>
      <% @batches.each do |batch| %>
      <tr>
        <td><%= link_to batch.number, variant_batch_path(batch.variant, batch) %></td>
        <td><%= batch.variant&.sku_code || '-' %></td>
        <td><%= batch.quantity %></td>
        <td><%= batch.production_date&.strftime('%Y-%m-%d') || '-' %></td>
        <td><span class="status-<%= batch.status %>"><%= case batch.status when 'in_production' then '生产中' when 'in_stock' then '已入库' when 'sold_out' then '已售罄' when 'scrapped' then '已报废' end %></span></td>
        <td><%= batch.serial_numbers.count %></td>
        <td>
          <%= link_to '查看', variant_batch_path(batch.variant, batch), class: 'btn btn-sm' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="card-header fw-bold d-flex justify-content-between align-items-center">
    验货记录
    <% if @product.lifecycle_state == 'production' %>
      <div>
        <%= link_to '新建验货申请', new_inspection_request_path(product_id: @product.id), class: 'btn btn-sm btn-outline-primary' %>
        <%= link_to '新建验货记录', new_inspection_record_path(product_id: @product.id), class: 'btn btn-sm btn-outline-success' %>
      </div>
    <% end %>
  </div>
  <% if @product.inspection_records.any? %>
    <table class="table table-hover align-middle">
      <tr>
        <th>验货日期</th>
        <th>订单号</th>
        <th>参考号</th>
        <th>供应商</th>
        <th>数量</th>
        <th>结果</th>
        <th>报告</th>
        <th>操作</th>
      </tr>
      <% @product.inspection_records.order(created_at: :desc).each do |rec| %>
      <tr>
        <td><%= l(rec.inspection_date, format: :short) %></td>
        <td><%= rec.order_no %></td>
        <td><%= rec.reference_no %></td>
        <td><%= rec.supplier_name || '-' %></td>
        <td><%= rec.shipment_quantity %></td>
        <td>
          <% if rec.result == 'pass' %>
            <span class="badge bg-success">合格</span>
          <% elsif rec.result == 'fail' %>
            <span class="badge bg-danger">不合格</span>
          <% else %>
            <span class="badge bg-secondary">有条件</span>
          <% end %>
        </td>
        <td><%= rec.report ? link_to('查看', inspection_record_report_path(rec)) : '未创建' %></td>
        <td><%= link_to '查看', inspection_record_path(rec), class: 'btn btn-sm btn-outline-primary' %></td>
      </tr>
      <% end %>
    </table>
  <% else %>
    <p class="text-muted">暂无验货记录</p>
    <% if @product.lifecycle_state != 'production' %>
      <p class="small text-muted">提示：产品进入「量产」阶段后可创建验货记录</p>
    <% end %>
  <% end %>
</div>