<% content_for :title, '产品管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-watch"></i> 产品管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '新建产品', new_product_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: products_path, method: :get, data: { turbo_action: :advance } do %>
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label">分类筛选</label>
          <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: '全部分类', class: 'form-select' %>
        </div>
        <div class="col-md-2">
          <%= submit_tag '筛选', class: 'btn btn-primary w-100' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> 产品列表</span>
    <span class="text-muted" style="font-size: 0.85rem;">共 <%= @products.count %> 条</span>
  </div>
  <div class="card-body p-0">
    <% if @products.empty? %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无产品数据</div>
      </div>
    <% else %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th style="width: 90px;">图片</th>
            <th>编码</th>
            <th>名称</th>
            <th>分类</th>
            <th>主题</th>
            <th>克重</th>
            <th>生命周期</th>
            <th>发布状态</th>
            <th>变体</th>
            <th style="width: 280px; min-width: 280px;">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
          <tr>
            <td>
              <% if product.cover_image.present? %>
                <a href="<%= product.cover_image.image.url %>"
                   class="product-thumb"
                   data-bs-toggle="lightbox"
                   data-bs-title="<%= product.name %>"
                   onclick="lb_open(this.href, this.dataset.bsTitle); return false;">
                  <%= image_tag product.cover_image.image.url,
                                class: 'img-thumbnail product-thumb-img',
                                alt: product.name,
                                style: 'width: 72px; height: 72px; object-fit: cover;',
                                loading: 'lazy' %>
                </a>
              <% else %>
                <div class="product-thumb placeholder-img bg-light d-flex align-items-center justify-content-center text-muted">
                  <i class="bi bi-image fs-2"></i>
                </div>
              <% end %>
            </td>
            <td><%= link_to product.product_code, product_path(product), class: 'fw-semibold' %></td>
            <td><%= product.name %></td>
            <td><%= product.category&.name || '-' %></td>
            <td>
              <% if product.theme.present? %>
                <span class="badge bg-warning text-dark"><%= product.theme_label %></span>
              <% else %>
                -
              <% end %>
            </td>
            <td><%= product.base_weight ? "#{product.base_weight}g" : '-' %></td>
            <td><span class="badge bg-info"><%= product.lifecycle_state_label %></span></td>
            <td>
              <% if product.status == 'draft' %>
                <span class="badge badge-draft">草稿</span>
              <% elsif product.status == 'published' %>
                <span class="badge badge-released">已发布</span>
              <% elsif product.status == 'offline' %>
                <span class="badge badge-archived">已下架</span>
              <% end %>
            </td>
            <td><span class="badge bg-primary"><%= product.variants.count %></span>
            <td class="text-end" style="min-width: 220px;">
              <div class="d-flex gap-1 flex-wrap justify-content-start">
                <%= link_to '查看', product_path(product), class: 'btn btn-sm btn-outline-primary flex-shrink-0' %>
                <%= link_to '编辑', edit_product_path(product), class: 'btn btn-sm btn-outline-warning flex-shrink-0' %>
                <%= link_to '计价', calculate_price_product_path(product), class: 'btn btn-sm btn-outline-info flex-shrink-0' %>
                <% if product.status == 'draft' %>
                  <%= link_to '发布', publish_product_path(product), class: 'btn btn-sm btn-outline-success flex-shrink-0' %>
                <% end %>
                <% if product.status == 'published' %>
                  <%= link_to '下架', offline_product_path(product), class: 'btn btn-sm btn-outline-secondary flex-shrink-0' %>
                <% end %>
                <% if product.status == 'offline' %>
                  <%= link_to '重发', publish_product_path(product), class: 'btn btn-sm btn-outline-success flex-shrink-0' %>
                <% end %>
                <%= button_to '删除', product_path(product), method: :delete, form: { class: 'd-inline-flex' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger flex-shrink-0' %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
