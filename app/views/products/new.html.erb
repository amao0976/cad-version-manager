<% content_for :title, '新建产品' %>

<div class="page-header">
  <h1>新建产品</h1>
  <%= link_to '返回列表', products_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">产品信息</div>
  <% if @product.errors.any? %>
    <div class="alert alert-danger m-3 mb-0">
      <% @product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @product, url: products_path, method: :post, data: { turbo: false }, html: { multipart: true } do |f| %>
    <%= render partial: 'products/form_fields', locals: { f: f, submit_label: '创建产品' } %>
  <% end %>
</div>
