<%= form_with model: user, url: user.new_record? ? admin_users_path : admin_user_path(user), data: { turbo: false } do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :email, '邮箱', class: 'form-label' %>
    <%= f.email_field :email, class: 'form-control', required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :name, '姓名', class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :role, '角色', class: 'form-label' %>
    <%= f.select :role, options_for_select([
      ['管理员', 'admin'],
      ['经理', 'manager'],
      ['工程师', 'engineer'],
      ['访客', 'viewer']
    ], user.role), {}, class: 'form-select' %>
  </div>

  <div class="mb-3">
    <%= f.label :password, user.new_record? ? '密码' : '新密码（留空则不修改）', class: 'form-label' %>
    <%= f.password_field :password, class: 'form-control', required: user.new_record?, autocomplete: 'new-password' %>
  </div>

  <div class="mb-3">
    <%= f.label :password_confirmation, '确认密码', class: 'form-label' %>
    <%= f.password_field :password_confirmation, class: 'form-control', autocomplete: 'new-password' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit user.new_record? ? '创建用户' : '保存修改', class: 'btn btn-primary' %>
    <%= link_to '返回', admin_users_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
