<% content_for :title, "#{@category.name} - 分类详情" %>

<div class="page-header">
  <h1><%= @category.name %> - 分类详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', categories_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_category_path(@category), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">排序号:</span>
    <%= @category.sort_order %>
  </div>
  <div class="info-row">
    <span class="info-label">名称:</span>
    <%= @category.name %>
  </div>
  <div class="info-row">
    <span class="info-label">编码:</span>
    <%= @category.code %>
  </div>
  <div class="info-row">
    <span class="info-label">父级分类:</span>
    <%= @category.parent&.name || '顶级分类' %>
  </div>
  <div class="info-row">
    <span class="info-label">层级:</span>
    L<%= @category.level %>
  </div>
  <div class="info-row">
    <span class="info-label">描述:</span>
    <%= @category.description || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @category.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">子分类</div>
  <% if @category.children.empty? %>
    <p>暂无子分类</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>排序号</th>
        <th>名称</th>
        <th>编码</th>
        <th>产品数</th>
        <th>操作</th>
      </tr>
      <% @category.children.order(:sort_order).each do |child| %>
      <tr>
        <td><%= child.sort_order %></td>
        <td><%= link_to child.name, category_path(child) %></td>
        <td><%= child.code %></td>
        <td><%= child.products.count %></td>
        <td>
          <%= link_to '查看', category_path(child), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_category_path(child), class: 'btn btn-sm' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="card-header fw-bold">产品列表</div>
  <% if @category.products.empty? %>
    <p>暂无产品</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>产品编码</th>
        <th>名称</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
      <% @category.products.each do |product| %>
      <tr>
        <td><%= link_to product.product_code, product_path(product) %></td>
        <td><%= product.name %></td>
        <td><span class="status-<%= product.status %>"><%= case product.status when 'draft' then '草稿' when 'published' then '已发布' when 'offline' then '已下架' end %></span></td>
        <td>
          <%= link_to '查看', product_path(product), class: 'btn btn-sm' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>