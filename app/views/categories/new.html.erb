<% content_for :title, '新建分类' %>

<div class="page-header">
  <h1>新建分类</h1>
  <%= link_to '返回列表', categories_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">分类信息</div>
  <% if @category.errors.any? %>
    <div class="alert alert-danger">
      <% @category.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @category do |f| %>
    <div class="mb-3">
      <%= f.label :sort_order, '排序号', class: 'form-label'%>
      <%= f.number_field :sort_order, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :name, '名称', class: 'form-label'%>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :code, '编码', class: 'form-label'%>
      <%= f.text_field :code, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :parent_id, '父级分类', class: 'form-label'%>
      <%= f.collection_select :parent_id, @categories, :id, :name, { include_blank: '顶级分类' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :description, '描述', class: 'form-label'%>
      <%= f.text_area :description, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建分类', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>