<% content_for :title, '分类管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-tags"></i> 分类管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <% if current_user.admin? %>
      <%= link_to '导出 CSV', categories_export_path, class: 'btn btn-outline-success' %>
      <%= link_to '导入 CSV', categories_import_path, class: 'btn btn-outline-primary' %>
      <%= link_to '新建分类', new_category_path, class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> 分类列表</span>
    <span class="text-muted" style="font-size: 0.85rem;">共 <%= @categories.count %> 条</span>
  </div>
  <div class="card-body p-0">
    <% if @categories.empty? %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无分类数据</div>
      </div>
    <% else %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>排序</th>
            <th>名称</th>
            <th>编码</th>
            <th>层级</th>
            <th>产品数</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.where(parent_id: nil).order(:sort_order).each do |category| %>
            <tr>
              <td><%= category.sort_order %></td>
              <td><%= link_to category.name, category_path(category), class: 'fw-semibold' %></td>
              <td><%= category.code %></td>
              <td><span class="badge bg-primary">L<%= category.level %></span></td>
              <td><span class="badge bg-success"><%= category.products.count %></span></td>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to '查看', category_path(category), class: 'btn btn-sm btn-outline-primary' %>
                  <%= link_to '编辑', edit_category_path(category), class: 'btn btn-sm btn-outline-warning' %>
                  <%= button_to '删除', category_path(category), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
                </div>
              </td>
            </tr>
            <% category.children.order(:sort_order).each do |child| %>
              <tr>
                <td><%= child.sort_order %></td>
                <td style="padding-left: 2rem;"><%= link_to child.name, category_path(child) %></td>
                <td><%= child.code %></td>
                <td><span class="badge bg-info text-dark">L<%= child.level %></span></td>
                <td><span class="badge bg-success"><%= child.products.count %></span></td>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to '查看', category_path(child), class: 'btn btn-sm btn-outline-primary' %>
                    <%= link_to '编辑', edit_category_path(child), class: 'btn btn-sm btn-outline-warning' %>
                    <%= button_to '删除', category_path(child), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
                  </div>
                </td>
              </tr>
              <% child.children.order(:sort_order).each do |grandchild| %>
                <tr>
                  <td><%= grandchild.sort_order %></td>
                  <td style="padding-left: 4rem;"><%= link_to grandchild.name, category_path(grandchild) %></td>
                  <td><%= grandchild.code %></td>
                  <td><span class="badge bg-secondary">L<%= grandchild.level %></span></td>
                  <td><span class="badge bg-success"><%= grandchild.products.count %></span></td>
                  <td>
                    <div class="d-flex gap-1">
                      <%= link_to '查看', category_path(grandchild), class: 'btn btn-sm btn-outline-primary' %>
                      <%= link_to '编辑', edit_category_path(grandchild), class: 'btn btn-sm btn-outline-warning' %>
                      <%= button_to '删除', category_path(grandchild), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
