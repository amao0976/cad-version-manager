<% content_for :title, "#{@batch.number} - 批次详情" %>

<div class="page-header">
  <h1><%= @batch.number %> - 批次详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回批次列表', variant_batches_path(@variant), class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_variant_batch_path(@variant, @batch), class: 'btn btn-outline-secondary' %>
    <% if @batch.status == 'in_production' %>
      <%= link_to '入库', receive_stock_variant_batch_path(@variant, @batch), method: :post, class: 'btn btn-success' %>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">批次号:</span>
    <%= @batch.number %>
  </div>
  <div class="info-row">
    <span class="info-label">所属变体:</span>
    <%= link_to @variant.sku_code, product_variant_path(@variant.product, @variant) %>
  </div>
  <div class="info-row">
    <span class="info-label">数量:</span>
    <%= @batch.quantity %>
  </div>
  <div class="info-row">
    <span class="info-label">生产日期:</span>
    <%= @batch.production_date&.strftime('%Y-%m-%d') || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">供应商:</span>
    <%= @batch.supplier || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">状态:</span>
    <span class="status-<%= @batch.status %>"><%= case @batch.status when 'in_production' then '生产中' when 'in_stock' then '已入库' when 'sold_out' then '已售罄' when 'scrapped' then '已报废' end %></span>
  </div>
  <div class="info-row">
    <span class="info-label">序列号数:</span>
    <%= @batch.serial_numbers.count %>
  </div>
  <div class="info-row">
    <span class="info-label">备注:</span>
    <%= @batch.remark || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @batch.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>

<% if @batch.status == 'in_production' %>
  <div class="card">
    <div class="card-header fw-bold">入库操作</div>
    <%= form_with url: receive_stock_variant_batch_path(@variant, @batch), method: :post do |f| %>
      <div class="mb-3">
        <label>入库数量</label>
        <%= number_field_tag :quantity, @batch.quantity, min: 1 %>
      </div>
      <div class="mb-3">
        <label>起始序列号</label>
        <%= text_field_tag :start_code, nil, placeholder: '选填，留空则自动生成' %>
      </div>
      <div class="mb-3">
        <%= submit_tag '确认入库', class: 'btn btn-success' %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="card">
  <div class="card-header fw-bold">序列号列表</div>
  <div style="margin-bottom: 15px;">
    <%= link_to '新建序列号', new_serial_number_path(batch_id: @batch.id), class: 'btn btn-outline-secondary' %>
  </div>
  <% if @batch.serial_numbers.empty? %>
    <p>暂无序列号</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>编码</th>
        <th>证书号</th>
        <th>状态</th>
        <th>售出时间</th>
        <th>操作</th>
      </tr>
      <% @batch.serial_numbers.each do |sn| %>
      <tr>
        <td><%= link_to sn.code, serial_number_path(sn) %></td>
        <td><%= sn.certificate_no || '-' %></td>
        <td><span class="status-<%= sn.status %>"><%= case sn.status when 'in_stock' then '在库' when 'sold' then '已售出' when 'returned' then '已退货' when 'scrapped' then '已报废' end %></span></td>
        <td><%= sn.sold_at&.strftime('%Y-%m-%d %H:%M') || '-' %></td>
        <td>
          <%= link_to '查看', serial_number_path(sn), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_serial_number_path(sn), class: 'btn btn-sm' %>
          <%= button_to '删除', serial_number_path(sn), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>