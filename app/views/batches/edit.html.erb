<% content_for :title, '编辑批次' %>

<div class="page-header">
  <h1>编辑批次</h1>
  <%= link_to '返回列表', variant_batches_path(@variant), class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">批次信息</div>
  <div class="variant-info">
    变体：<span><%= @variant.sku_code %></span> | 
    材质：<span><%= @variant.material&.name || '-' %></span>
  </div>
  <% if @batch.errors.any? %>
    <div class="alert alert-danger">
      <% @batch.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with(model: [@variant, @batch], url: variant_batch_path(@variant, @batch), method: :patch) do |f| %>
    <div class="mb-3">
      <%= f.label :number, '批次号', class: 'form-label'%>
      <%= f.text_field :number, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :quantity, '数量', class: 'form-label'%>
      <%= f.number_field :quantity, class: 'form-control', min: 1 %>
    </div>
    <div class="mb-3">
      <%= f.label :production_date, '生产日期', class: 'form-label'%>
      <%= f.date_field :production_date, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :supplier, '供应商', class: 'form-label'%>
      <%= f.text_field :supplier, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :status, '状态', class: 'form-label'%>
      <%= f.select :status, [['生产中', 'in_production'], ['已入库', 'in_stock'], ['已售罄', 'sold_out'], ['已报废', 'scrapped']], {}, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :remark, '备注', class: 'form-label'%>
      <%= f.text_area :remark, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '更新批次', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>