<% content_for :title, "#{@variant.sku_code} - 批次列表" %>

<div class="page-header">
  <h1><%= @variant.sku_code %> - 批次列表</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回变体', product_variant_path(@variant.product, @variant), class: 'btn btn-outline-secondary' %>
    <%= link_to '新建批次', new_variant_batch_path(@variant), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">批次列表</div>
  <div class="variant-info">
    变体：<span><%= @variant.sku_code %></span> | 
    材质：<span><%= @variant.material&.name || '-' %></span> | 
    尺寸：<span><%= @variant.size || '-' %></span>
  </div>
  <% if @batches.empty? %>
    <p>暂无批次数据</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>批次号</th>
        <th>数量</th>
        <th>生产日期</th>
        <th>供应商</th>
        <th>状态</th>
        <th>序列号数</th>
        <th>操作</th>
      </tr>
      <% @batches.each do |batch| %>
      <tr>
        <td><%= link_to batch.number, variant_batch_path(@variant, batch) %></td>
        <td><%= batch.quantity %></td>
        <td><%= batch.production_date&.strftime('%Y-%m-%d') || '-' %></td>
        <td><%= batch.supplier || '-' %></td>
        <td><span class="status-<%= batch.status %>"><%= case batch.status when 'in_production' then '生产中' when 'in_stock' then '已入库' when 'sold_out' then '已售罄' when 'scrapped' then '已报废' end %></span></td>
        <td><%= batch.serial_numbers.count %></td>
        <td>
          <%= link_to '查看', variant_batch_path(@variant, batch), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_variant_batch_path(@variant, batch), class: 'btn btn-sm' %>
          <% if batch.status == 'in_production' %>
            <%= link_to '入库', receive_stock_variant_batch_path(@variant, batch), method: :post, class: 'btn btn-sm' %>
          <% end %>
          <%= button_to '删除', variant_batch_path(@variant, batch), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>