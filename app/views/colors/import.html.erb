<% content_for :title, '导入颜色' %>

<div class="page-header">
  <h1>导入颜色</h1>
  <%= link_to '返回列表', colors_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card mb-4">
  <div class="card-header fw-bold">CSV 导入说明</div>
  <div class="card-body">
    <h5>CSV 文件格式要求：</h5>
    <ul>
      <li><strong>编码：</strong>UTF-8 (支持带 BOM 的 Excel 导出文件)</li>
      <li><strong>必需列：</strong>颜色名称 (name)、颜色编码 (code)、颜色类型 (color_type)</li>
      <li><strong>可选列：</strong>HEX代码 (hex_code)、描述 (description)、启用状态 (active)</li>
    </ul>

    <h5>颜色类型可选值：</h5>
    <table class="table table-sm">
      <thead>
        <tr>
          <th>中文</th>
          <th>英文</th>
          <th>代码值</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>电镀颜色</td>
          <td>plating / electroplating</td>
          <td>plating</td>
        </tr>
        <tr>
          <td>布料皮料颜色</td>
          <td>fabric_leather / fabric / leather</td>
          <td>fabric_leather</td>
        </tr>
        <tr>
          <td>其他颜色</td>
          <td>other</td>
          <td>other</td>
        </tr>
      </tbody>
    </table>

    <h5>启用状态可选值：</h5>
    <p>true / 1 / yes / 是 / enabled / 启用 = 启用；false / 0 / no / 否 / disabled / 停用 = 停用</p>

    <div class="alert alert-info mt-3">
      <strong>提示：</strong>如果颜色编码已存在，系统将更新该颜色的信息而不是创建新记录。
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">上传 CSV 文件</div>
  <div class="card-body">
    <% if defined?(@errors) && @errors.any? %>
      <div class="alert alert-danger">
        <h6>导入失败，以下是错误信息：</h6>
        <ul class="mb-0">
          <% @errors.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: colors_do_import_path, method: :post, multipart: true, data: { turbo: false } do |f| %>
      <div class="mb-3">
        <label class="form-label">选择 CSV 文件</label>
        <%= file_field_tag :csv_file, class: 'form-control', accept: '.csv' %>
        <div class="form-text">支持 .csv 格式文件</div>
      </div>
      <div class="mb-3">
        <%= f.submit '开始导入', class: 'btn btn-primary' %>
        <%= link_to '取消', colors_path, class: 'btn btn-outline-secondary ms-2' %>
      </div>
    <% end %>
  </div>
</div>
