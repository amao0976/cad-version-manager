<%= form_with model: @supplier do |f| %>
  <% if @supplier.errors.any? %>
    <div class="alert alert-danger">
      <% @supplier.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, '供应商名称', class: 'form-label'%>
    <%= f.text_field :name, class: 'form-control', required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :code, '供应商编码', class: 'form-label'%>
    <%= f.text_field :code, class: 'form-control', required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :short_name, '简称', class: 'form-label'%>
    <%= f.text_field :short_name, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :supplier_type, '供应商类型', class: 'form-label'%>
    <%= f.select :supplier_type, Supplier.supplier_types.map { |k, v| [v, k] }, {}, class: 'form-select' %>
  </div>
  <div class="mb-3">
    <%= f.label :level, '等级', class: 'form-label'%>
    <%= f.select :level, Supplier.levels.map { |k, v| [v, k] }, {}, class: 'form-select' %>
  </div>
  <div class="mb-3">
    <%= f.label :status, '状态', class: 'form-label'%>
    <%= f.select :status, Supplier.statuses.map { |k, v| [v, k] }, {}, class: 'form-select' %>
  </div>

  <h3 style="margin-top: 25px; color: #007bff;">联系信息</h3>
  <div class="mb-3">
    <%= f.label :contact_person, '联系人', class: 'form-label'%>
    <%= f.text_field :contact_person, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :phone, '电话', class: 'form-label'%>
    <%= f.text_field :phone, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :email, '邮箱', class: 'form-label'%>
    <%= f.text_field :email, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :address, '地址', class: 'form-label'%>
    <%= f.text_field :address, class: 'form-control' %>
  </div>

  <h3 style="margin-top: 25px; color: #007bff;">财务信息</h3>
  <div class="mb-3">
    <%= f.label :bank_name, '开户银行', class: 'form-label'%>
    <%= f.text_field :bank_name, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :bank_account, '银行账号', class: 'form-label'%>
    <%= f.text_field :bank_account, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :tax_number, '税号', class: 'form-label'%>
    <%= f.text_field :tax_number, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.label :remark, '备注', class: 'form-label'%>
    <%= f.text_area :remark, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.submit (@supplier.new_record? ? '创建供应商' : '更新供应商'), class: 'btn btn-primary' %>
  </div>
<% end %>