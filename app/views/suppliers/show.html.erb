<% content_for :title, "#{@supplier.name} - 供应商详情" %>

<div class="page-header">
  <h1><%= @supplier.name %></h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', suppliers_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_supplier_path(@supplier), class: 'btn btn-outline-secondary' %>
    <%= link_to '管理工厂', factories_path(supplier_id: @supplier.id), class: 'btn btn-primary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row"><span class="info-label">编码:</span> <%= @supplier.code %></div>
  <div class="info-row"><span class="info-label">简称:</span> <%= @supplier.short_name || '-' %></div>
  <div class="info-row"><span class="info-label">类型:</span> <%= @supplier.display_type %></div>
  <div class="info-row"><span class="info-label">等级:</span> <span class="badge badge-<%= @supplier.level %>"><%= @supplier.display_level %></span></div>
  <div class="info-row"><span class="info-label">状态:</span> <span class="badge badge-<%= @supplier.status %>"><%= @supplier.display_status %></span></div>
  <div class="info-row"><span class="info-label">创建时间:</span> <%= @supplier.created_at.strftime('%Y-%m-%d %H:%M') %></div>
</div>

<div class="card">
  <div class="card-header fw-bold">联系方式</div>
  <div class="info-row"><span class="info-label">联系人:</span> <%= @supplier.contact_person || '-' %></div>
  <div class="info-row"><span class="info-label">电话:</span> <%= @supplier.phone || '-' %></div>
  <div class="info-row"><span class="info-label">邮箱:</span> <%= @supplier.email || '-' %></div>
  <div class="info-row"><span class="info-label">地址:</span> <%= @supplier.address || '-' %></div>
</div>

<div class="card">
  <div class="card-header fw-bold">财务信息</div>
  <div class="info-row"><span class="info-label">开户银行:</span> <%= @supplier.bank_name || '-' %></div>
  <div class="info-row"><span class="info-label">银行账号:</span> <%= @supplier.bank_account || '-' %></div>
  <div class="info-row"><span class="info-label">税号:</span> <%= @supplier.tax_number || '-' %></div>
</div>

<div class="card">
  <div class="card-header fw-bold">备注</div>
  <p><%= @supplier.remark || '无' %></p>
</div>

<!-- 下属工厂 -->
<div class="card">
  <div class="card-header fw-bold d-flex justify-content-between align-items-center">
    下属工厂
    <%= link_to '添加工厂', factories_path(supplier_id: @supplier.id), class: 'btn btn-sm btn-outline-primary' %>
  </div>
  <div class="card-body">
    <% if @supplier.factories.any? %>
      <table class="table table-hover">
        <thead>
          <tr>
            <th>工厂名称</th>
            <th>位置</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          <% @supplier.factories.each do |factory| %>
            <tr>
              <td><%= factory.name %></td>
              <td><%= [factory.country, factory.province, factory.city].filter(Boolean).join(' / ') || '-' %></td>
              <td><%= factory.remarks || '-' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted text-center">暂无下属工厂</p>
    <% end %>
  </div>
</div>