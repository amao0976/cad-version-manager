<% content_for :title, '供应商管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-building"></i> 供应商管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '新建供应商', new_supplier_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-4 search-card">
  <div class="card-body">
    <div class="section-title"><i class="bi bi-search"></i> 搜索筛选</div>
    <%= form_with url: suppliers_path, method: :get, data: { turbo_action: :advance } do %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label">关键词</label>
          <%= text_field_tag :keyword, params[:keyword], placeholder: '名称/编码/联系人/电话', class: 'form-control' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">类型</label>
          <%= select_tag :supplier_type, options_for_select([['全部类型', '']] + Supplier.supplier_types.map { |k, v| [v, k] }, params[:supplier_type]), class: 'form-select' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">状态</label>
          <%= select_tag :status, options_for_select([['全部状态', '']] + Supplier.statuses.map { |k, v| [v, k] }, params[:status]), class: 'form-select' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">等级</label>
          <%= select_tag :level, options_for_select([['全部等级', '']] + Supplier.levels.map { |k, v| [v, k] }, params[:level]), class: 'form-select' %>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <%= submit_tag '搜索', class: 'btn btn-primary flex-fill' %>
          <%= link_to '重置', suppliers_path, class: 'btn btn-outline-secondary' %>
        </div>
      </div>
    <% end %>
    <div class="mt-2 text-muted" style="font-size: 0.85rem;">共 <strong><%= @suppliers.count %></strong> 条记录</div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> 供应商列表</span>
  </div>
  <div class="card-body p-0">
    <% if @suppliers.empty? %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无供应商数据</div>
      </div>
    <% else %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>编码</th>
            <th>名称</th>
            <th>类型</th>
            <th>联系人</th>
            <th>电话</th>
            <th>等级</th>
            <th>状态</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @suppliers.each do |s| %>
          <tr>
            <td><%= s.code %></td>
            <td><%= link_to s.name, supplier_path(s), class: 'fw-semibold' %></td>
            <td><span class="badge bg-info text-dark"><%= s.display_type %></span></td>
            <td><%= s.contact_person || '-' %></td>
            <td><%= s.phone || '-' %></td>
            <td><%= s.display_level %></td>
            <td><%= s.display_status %></td>
            <td>
              <div class="d-flex gap-1">
                <%= link_to '查看', supplier_path(s), class: 'btn btn-sm btn-outline-primary' %>
                <%= link_to '编辑', edit_supplier_path(s), class: 'btn btn-sm btn-outline-warning' %>
                <%= button_to '删除', supplier_path(s), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
