<% content_for :title, 'PLM 产品生命周期管理' %>

<div class="page-header mb-4">
  <h1>PLM 产品生命周期管理</h1>
</div>

<!-- 产品生命周期统计 -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header fw-bold d-flex justify-content-between align-items-center">
        产品生命周期概览
        <%= link_to '产品列表', products_path, class: 'btn btn-sm btn-outline-primary' %>
      </div>
      <div class="card-body">
        <div class="row text-center">
          <% Product.lifecycle_states.each do |label, state| %>
            <div class="col">
              <div class="lifecycle-badge lifecycle-<%= state %> p-3 rounded">
                <div class="fs-4 fw-bold"><%= Product.where(lifecycle_state: state).count %></div>
                <div class="small"><%= label %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 生命周期流程图 -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header fw-bold">生命周期流程</div>
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-center flex-wrap gap-2">
          <% Product.lifecycle_states.each_with_index do |(label, state), index| %>
            <% if index > 0 %>
              <span class="text-muted fs-4">→</span>
            <% end %>
            <span class="badge bg-secondary p-2"><%= label %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <!-- 左列：最近生命周期变更 -->
  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold">最近生命周期变更</div>
      <div class="card-body">
        <% if @recent_lifecycle_changes.any? %>
          <div class="list-group">
            <% @recent_lifecycle_changes.each do |history| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= link_to history.product.name, product_path(history.product) %></strong>
                    <span class="badge bg-info"><%= history.from_state_label %></span>
                    →
                    <span class="badge bg-success"><%= history.to_state_label %></span>
                  </div>
                  <small class="text-muted"><%= l(history.created_at, format: :short) %></small>
                </div>
                <% if history.remark.present? %>
                  <small class="text-muted"><%= history.remark %></small>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">暂无生命周期变更记录</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 右列：文档管理 -->
  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold d-flex justify-content-between align-items-center">
        文档管理
        <%= link_to '文档列表', documents_path, class: 'btn btn-sm btn-outline-primary' %>
      </div>
      <div class="card-body">
        <div class="row text-center mb-3">
          <% Document.statuses.each do |label, status| %>
            <div class="col">
              <div class="doc-badge doc-<%= status %> p-2 rounded">
                <div class="fs-5 fw-bold"><%= Document.where(status: status).count %></div>
                <div class="small"><%= label %></div>
              </div>
            </div>
          <% end %>
        </div>

        <% if @pending_documents.any? %>
          <div class="alert alert-warning">
            <strong>待审批文档：</strong>
            <ul class="mb-0 mt-1">
              <% @pending_documents.each do |doc| %>
                <li><%= link_to doc.title, document_path(doc) %> (<%= doc.doc_number %>)</li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <h6 class="mt-3">最近更新文档</h6>
        <% if @recent_documents.any? %>
          <div class="list-group">
            <% @recent_documents.each do |doc| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= link_to doc.title, document_path(doc) %></strong>
                    <span class="badge bg-secondary"><%= doc.doc_type_label %></span>
                    <span class="badge bg-<%= doc.status == 'released' ? 'success' : 'secondary' %>"><%= doc.status_label %></span>
                  </div>
                  <small class="text-muted"><%= doc.current_version %></small>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">暂无文档</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- BOM 与图纸统计 -->
<div class="row">
  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold">BOM 审批状态</div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col"><strong class="fs-5"><%= @bom_stats['draft'] %></strong><div class="small text-muted">草稿</div></div>
          <div class="col"><strong class="fs-5"><%= @bom_stats['submitted'] %></strong><div class="small text-muted">已提交</div></div>
          <div class="col"><strong class="fs-5"><%= @bom_stats['approved'] %></strong><div class="small text-muted">已审批</div></div>
          <div class="col"><strong class="fs-5"><%= @bom_stats['released'] %></strong><div class="small text-muted">已发布</div></div>
        </div>
        <div class="mt-3 text-center">
          <%= link_to 'BOM 管理', boms_path, class: 'btn btn-sm btn-outline-primary' %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold">设计图纸统计</div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col"><strong class="fs-5"><%= @drawing_stats['total'] %></strong><div class="small text-muted">图纸总数</div></div>
          <div class="col"><strong class="fs-5"><%= @drawing_stats['with_versions'] %></strong><div class="small text-muted">有版本记录</div></div>
        </div>
        <div class="mt-3 text-center">
          <%= link_to '图纸管理', design_drawings_path, class: 'btn btn-sm btn-outline-primary' %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 验货管理统计 -->
<div class="row">
  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold d-flex justify-content-between align-items-center">
        验货管理统计
        <div>
          <%= link_to '验货申请', inspection_requests_path, class: 'btn btn-sm btn-outline-primary' %>
          <%= link_to '验货记录', inspection_records_path, class: 'btn btn-sm btn-outline-secondary' %>
        </div>
      </div>
      <div class="card-body">
        <div class="row text-center mb-3">
          <div class="col"><strong class="fs-5"><%= @inspection_stats['total_requests'] %></strong><div class="small text-muted">申请总数</div></div>
          <div class="col"><strong class="fs-5 text-warning"><%= @inspection_stats['pending_requests'] %></strong><div class="small text-muted">待处理</div></div>
          <div class="col"><strong class="fs-5"><%= @inspection_stats['total_records'] %></strong><div class="small text-muted">记录总数</div></div>
          <div class="col"><strong class="fs-5 text-success"><%= @inspection_stats['passed'] %></strong><div class="small text-muted">合格</div></div>
          <div class="col"><strong class="fs-5 text-danger"><%= @inspection_stats['failed'] %></strong><div class="small text-muted">不合格</div></div>
        </div>

        <% if @recent_inspections.any? %>
          <h6 class="mt-2">最近验货记录</h6>
          <div class="list-group">
            <% @recent_inspections.each do |rec| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= link_to rec.order_no, inspection_record_path(rec) %></strong>
                    <span class="text-muted">·</span>
                    <span><%= rec.product&.name || '无产品关联' %></span>
                  </div>
                  <div>
                    <% if rec.result == 'pass' %>
                      <span class="badge bg-success">合格</span>
                    <% elsif rec.result == 'fail' %>
                      <span class="badge bg-danger">不合格</span>
                    <% else %>
                      <span class="badge bg-secondary">有条件</span>
                    <% end %>
                    <small class="text-muted ms-2"><%= l(rec.inspection_date, format: :short) %></small>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card mb-4">
      <div class="card-header fw-bold">量产阶段入口</div>
      <div class="card-body">
        <p class="text-muted">验货管理属于产品生命周期的「量产」阶段。</p>
        <div class="d-flex gap-2 flex-wrap">
          <%= link_to '创建验货申请', new_inspection_request_path, class: 'btn btn-primary' %>
          <%= link_to '创建验货记录', new_inspection_record_path, class: 'btn btn-outline-primary' %>
        </div>
        <hr>
        <p class="small text-muted">
          <strong>提示：</strong>当产品进入「量产」阶段后，可以在此创建验货申请和验货记录。
          验货流程：申请 → 排期 → 验货 → 报告 → 完成
        </p>
      </div>
    </div>
  </div>
</div>

<style>
.lifecycle-badge { border: 1px solid #dee2e6; }
.lifecycle-concept { background-color: #e3f2fd; }
.lifecycle-design { background-color: #fff3e0; }
.lifecycle-prototype { background-color: #f3e5f5; }
.lifecycle-pilot { background-color: #e8f5e9; }
.lifecycle-production { background-color: #c8e6c9; }
.lifecycle-phase_out { background-color: #fff9c4; }
.lifecycle-obsolete { background-color: #ffebee; }

.doc-badge { border: 1px solid #dee2e6; }
.doc-draft { background-color: #f5f5f5; }
.doc-submitted { background-color: #fff3e0; }
.doc-approved { background-color: #e8f5e9; }
.doc-released { background-color: #c8e6c9; }
.doc-superseded { background-color: #ffebee; }
</style>
