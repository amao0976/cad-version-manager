<% content_for :title, '序列号管理' %>

<div class="page-header">
  <h1>序列号管理</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '新建序列号', new_serial_number_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">序列号列表</div>
  <div class="search-bar">
    <%= form_with url: serial_numbers_path, method: :get, data: { turbo: false } do |f| %>
      <label>搜索：</label>
      <%= text_field_tag :code, params[:code], placeholder: '按编码搜索' %>
      <%= submit_tag '搜索', class: 'btn btn-outline-secondary' %>
      <% if params[:code].present? %>
        <%= link_to '重置', serial_numbers_path, class: 'btn btn-outline-secondary' %>
      <% end %>
    <% end %>
  </div>
  <% if @serial_numbers.empty? %>
    <p>暂无序列号数据</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>编码</th>
        <th>证书号</th>
        <th>变体</th>
        <th>批次</th>
        <th>状态</th>
        <th>售出时间</th>
        <th>操作</th>
      </tr>
      <% @serial_numbers.each do |sn| %>
      <tr>
        <td><%= link_to sn.code, serial_number_path(sn) %></td>
        <td><%= sn.certificate_no || '-' %></td>
        <td><%= sn.variant&.sku_code || '-' %></td>
        <td><%= sn.batch&.number || '-' %></td>
        <td><span class="status-<%= sn.status %>"><%= case sn.status when 'in_stock' then '在库' when 'sold' then '已售出' when 'returned' then '已退货' when 'scrapped' then '已报废' end %></span></td>
        <td><%= sn.sold_at&.strftime('%Y-%m-%d %H:%M') || '-' %></td>
        <td>
          <%= link_to '查看', serial_number_path(sn), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_serial_number_path(sn), class: 'btn btn-sm' %>
          <%= button_to '删除', serial_number_path(sn), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>