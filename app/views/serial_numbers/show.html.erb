<% content_for :title, "#{@serial_number.code} - 序列号详情" %>

<div class="page-header">
  <h1><%= @serial_number.code %> - 序列号详情</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回列表', serial_numbers_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '编辑', edit_serial_number_path(@serial_number), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">基本信息</div>
  <div class="info-row">
    <span class="info-label">编码:</span>
    <%= @serial_number.code %>
  </div>
  <div class="info-row">
    <span class="info-label">证书号:</span>
    <%= @serial_number.certificate_no || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">所属产品:</span>
    <%= @serial_number.variant&.product&.name || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">变体:</span>
    <%= @serial_number.variant&.sku_code || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">批次:</span>
    <%= @serial_number.batch&.number || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">状态:</span>
    <span class="status-<%= @serial_number.status %>"><%= case @serial_number.status when 'in_stock' then '在库' when 'sold' then '已售出' when 'returned' then '已退货' when 'scrapped' then '已报废' end %></span>
  </div>
  <div class="info-row">
    <span class="info-label">售出时间:</span>
    <%= @serial_number.sold_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
  </div>
  <div class="info-row">
    <span class="info-label">创建时间:</span>
    <%= @serial_number.created_at.strftime('%Y-%m-%d %H:%M') %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">追溯信息</div>
  <ul class="trace-list">
    <li class="trace-item">
      <div class="trace-title">入库</div>
      <div>批次：<%= @serial_number.batch&.number || '-' %></div>
      <div class="trace-time"><%= @serial_number.batch&.created_at&.strftime('%Y-%m-%d %H:%M') || '-' %></div>
    </li>
    <li class="trace-item">
      <div class="trace-title">生产</div>
      <div>生产日期：<%= @serial_number.batch&.production_date&.strftime('%Y-%m-%d') || '-' %></div>
      <div class="trace-time">生产数量：<%= @serial_number.batch&.quantity || '-' %></div>
    </li>
    <li class="trace-item">
      <div class="trace-title">创建</div>
      <div>序列号创建</div>
      <div class="trace-time"><%= @serial_number.created_at.strftime('%Y-%m-%d %H:%M') %></div>
    </li>
  </ul>
</div>