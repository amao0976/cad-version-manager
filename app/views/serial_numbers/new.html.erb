<% content_for :title, '新建序列号' %>

<div class="page-header">
  <h1>新建序列号</h1>
  <%= link_to '返回列表', serial_numbers_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">序列号信息</div>
  <% if @serial_number.errors.any? %>
    <div class="alert alert-danger">
      <% @serial_number.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: @serial_number do |f| %>
    <div class="mb-3">
      <%= f.label :code, '编码', class: 'form-label'%>
      <%= f.text_field :code, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :certificate_no, '证书号', class: 'form-label'%>
      <%= f.text_field :certificate_no, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :batch_id, '批次', class: 'form-label'%>
      <%= f.collection_select :batch_id, @batches, :id, :number, { include_blank: '请选择批次' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :variant_id, '变体', class: 'form-label'%>
      <%= f.collection_select :variant_id, @variants, :id, :sku_code, { include_blank: '请选择变体' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :status, '状态', class: 'form-label'%>
      <%= f.select :status, [['在库', 'in_stock'], ['已售出', 'sold'], ['已退货', 'returned'], ['已报废', 'scrapped']], {}, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :sold_at, '售出时间', class: 'form-label'%>
      <%= f.datetime_local_field :sold_at, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建序列号', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>