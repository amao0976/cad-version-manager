<% content_for :title, '添加物料项' %>

<div class="page-header">
  <h1>添加物料项 - <%= @bom.name %></h1>
  <%= link_to '返回BOM详情', bom_path(@bom), class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">物料信息</div>
  <% if @item.errors.any? %>
    <div class="alert alert-danger">
      <% @item.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with(model: @item, url: bom_create_item_path(@bom), method: :post) do |f| %>
    <div class="row">
      <div class="mb-3">
        <%= f.label :part_number, '物料编号', class: 'form-label'%>
        <%= f.text_field :part_number, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= f.label :part_name, '物料名称', class: 'form-label'%>
        <%= f.text_field :part_name, class: 'form-control' %>
      </div>
    </div>
    <div class="mb-3">
      <%= f.label :design_drawing_id, '关联图纸', class: 'form-label'%>
      <%= f.collection_select :design_drawing_id, @drawings, :id, :name, { include_blank: '不关联图纸' }, class: 'form-select' %>
    </div>
    <div class="row">
      <div class="mb-3">
        <%= f.label :material, '材质', class: 'form-label'%>
        <%= f.text_field :material, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= f.label :specification, '规格', class: 'form-label'%>
        <%= f.text_field :specification, class: 'form-control' %>
      </div>
    </div>
    <div class="mb-3">
      <%= f.label :color_id, '颜色', class: 'form-label'%>
      <% color_groups = @colors.group_by { |c| c.color_type } %>
      <% options = color_groups.map do |type, colors|
        [Color.color_types.key(type) || type, colors.map { |c| [c.name, c.id] }]
      end %>
      <%= f.grouped_collection_select :color_id, options, :last, :first, :last, :first, { include_blank: '请选择颜色（可选）' }, class: 'form-select' %>
      <div class="form-text">电镀颜色适用于金属配件，布料皮料颜色适用于布料/皮料配件</div>
    </div>
    <div class="row">
      <div class="mb-3">
        <%= f.label :quantity, '数量', class: 'form-label'%>
        <%= f.number_field :quantity, class: 'form-control', value: 1, step: 0.1 %>
      </div>
      <div class="mb-3">
        <%= f.label :unit, '单位', class: 'form-label'%>
        <%= f.text_field :unit, class: 'form-control', value: '件' %>
      </div>
      <div class="mb-3">
        <%= f.label :weight, '重量', class: 'form-label'%>
        <%= f.number_field :weight, class: 'form-control', step: 0.001 %>
      </div>
    </div>
    <div class="row">
      <div class="mb-3">
        <%= f.label :source, '来源', class: 'form-label'%>
        <%= f.select :source, BomItem.sources.map { |k, v| [v, k] }, {}, class: 'form-select' %>
      </div>
      <div class="mb-3">
        <%= f.label :level, '层级', class: 'form-label'%>
        <%= f.number_field :level, class: 'form-control', value: 1, min: 1 %>
      </div>
    </div>
    <div class="mb-3">
      <%= f.submit '添加物料项', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>