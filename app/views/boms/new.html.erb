<% content_for :title, '新建BOM' %>

<div class="page-header">
  <h1>新建BOM</h1>
  <%= link_to '返回列表', boms_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">BOM信息</div>
  <% if @bom.errors.any? %>
    <div class="alert alert-danger">
      <% @bom.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with(model: @bom, url: boms_path, method: :post) do |f| %>
    <div class="mb-3">
      <%= f.label :name, class: 'form-label'%>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :product_id, '关联产品', class: 'form-label'%>
      <%= f.collection_select :product_id, @products, :id, :name, { include_blank: '不关联产品' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :design_project_id, '所属项目', class: 'form-label'%>
      <%= f.collection_select :design_project_id, @projects, :id, :name, { prompt: '选择项目' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :design_drawing_id, '关联图纸', class: 'form-label'%>
      <%= f.collection_select :design_drawing_id, @drawings, :id, :name, { include_blank: '不关联图纸' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :revision, '版本', class: 'form-label'%>
      <%= f.text_field :revision, class: 'form-control', value: 'A' %>
    </div>
    <div class="mb-3">
      <%= f.label :status, '状态', class: 'form-label'%>
      <%= f.select :status, ProductBom.statuses.map { |k, v| [v, k] }, { prompt: '选择状态' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :description, '描述', class: 'form-label'%>
      <%= f.text_area :description, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建BOM', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>