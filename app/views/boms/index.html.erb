<% content_for :title, 'BOM管理' %>

<div class="page-header">
  <div>
    <h1><i class="bi bi-box-seam"></i> BOM 管理</h1>
  </div>
  <div class="d-flex gap-2">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-outline-secondary' %>
    <%= link_to '新建 BOM', new_bom_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-4 search-card">
  <div class="card-body">
    <div class="section-title"><i class="bi bi-search"></i> 搜索筛选</div>
    <%= form_with url: boms_path, method: :get, data: { turbo_action: :advance } do %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label">关键词</label>
          <%= text_field_tag :keyword, params[:keyword], placeholder: '名称/版本', class: 'form-control' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">产品类别</label>
          <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: '全部类别', class: 'form-select' %>
        </div>
        <div class="col-md-3">
          <label class="form-label">产品</label>
          <%= select_tag :product_id, options_from_collection_for_select(@products, :id, :name, params[:product_id]), include_blank: '全部产品', class: 'form-select' %>
        </div>
        <div class="col-md-2">
          <label class="form-label">状态</label>
          <%= select_tag :status, options_for_select([['全部状态', ''], ['草稿', 'draft'], ['已审批', 'approved'], ['已发布', 'released'], ['已归档', 'archived']], params[:status]), class: 'form-select' %>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <%= submit_tag '搜索', class: 'btn btn-primary flex-fill' %>
          <%= link_to '重置', boms_path, class: 'btn btn-outline-secondary' %>
        </div>
      </div>
    <% end %>
    <div class="mt-2 text-muted" style="font-size: 0.85rem;">共 <strong><%= @boms.count %></strong> 条记录</div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-list-ul"></i> BOM 列表</span>
  </div>
  <div class="card-body p-0">
    <% if @boms.empty? %>
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <div>暂无 BOM 数据</div>
      </div>
    <% else %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>名称</th>
            <th>产品</th>
            <th>类别</th>
            <th>项目</th>
            <th>版本</th>
            <th>状态</th>
            <th>物料数</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @boms.each do |bom| %>
          <tr>
            <td><%= link_to bom.name, bom_path(bom), class: 'fw-semibold' %></td>
            <td><%= bom.product&.name || '-' %></td>
            <td><%= bom.product&.category&.name || '-' %></td>
            <td><%= bom.design_project&.name %></td>
            <td><span class="badge bg-light text-dark"><%= bom.revision %></span></td>
            <td>
              <% if bom.status == 'draft' %>
                <span class="badge badge-draft">草稿</span>
              <% elsif bom.status == 'approved' %>
                <span class="badge badge-approved">已审批</span>
              <% elsif bom.status == 'released' %>
                <span class="badge badge-released">已发布</span>
              <% elsif bom.status == 'archived' %>
                <span class="badge badge-archived">已归档</span>
              <% end %>
            </td>
            <td><span class="badge bg-primary"><%= bom.bom_items.count %></span></td>
            <td>
              <div class="d-flex gap-1">
                <%= link_to '查看', bom_path(bom), class: 'btn btn-sm btn-outline-primary' %>
                <%= link_to '编辑', edit_bom_path(bom), class: 'btn btn-sm btn-outline-warning' %>
                <% if bom.status == 'draft' %>
                  <%= link_to '审批', bom_approve_path(bom), class: 'btn btn-sm btn-outline-info' %>
                <% end %>
                <% if bom.status == 'approved' %>
                  <%= link_to '发布', bom_release_path(bom), class: 'btn btn-sm btn-outline-success' %>
                <% end %>
                <%= button_to '删除', bom_path(bom), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-outline-danger' %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
