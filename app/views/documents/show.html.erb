<% content_for :title, @document.title %>

<div class="page-header mb-4">
  <h1><%= @document.title %></h1>
  <div class="d-flex gap-2 mt-2">
    <%= link_to '返回列表', documents_path, class: 'btn btn-outline-secondary' %>
    <% if current_user.admin? || current_user.engineer? %>
      <%= link_to '编辑', edit_document_path(@document), class: 'btn btn-outline-primary' %>
      <%= button_to '删除', @document, method: :delete, class: 'btn btn-outline-danger', data: { confirm: '确认删除？' } %>
    <% end %>
  </div>
</div>

<!-- 文档信息 -->
<div class="card mb-4">
  <div class="card-header fw-bold">文档信息</div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>文档编号：</strong><%= @document.doc_number %></p>
        <p><strong>文档类型：</strong><span class="badge bg-secondary"><%= @document.doc_type_label %></span></p>
        <p><strong>当前版本：</strong><%= @document.current_version %></p>
        <p><strong>状态：</strong><span class="badge bg-<%= @document.status == 'released' ? 'success' : 'secondary' %>"><%= @document.status_label %></span></p>
      </div>
      <div class="col-md-6">
        <p><strong>关联产品：</strong><%= @document.product ? link_to(@document.product.name, product_path(@document.product)) : '-' %></p>
        <p><strong>创建者：</strong><%= @document.created_by&.email || '-' %></p>
        <p><strong>创建时间：</strong><%= l(@document.created_at, format: :long) if @document.created_at %></p>
        <p><strong>更新时间：</strong><%= l(@document.updated_at, format: :long) if @document.updated_at %></p>
      </div>
    </div>
    <% if @document.description.present? %>
      <hr>
      <p><strong>描述：</strong></p>
      <p><%= @document.description %></p>
    <% end %>
  </div>
</div>

<!-- 上传新版本 -->
<% if current_user.admin? || current_user.engineer? %>
<div class="card mb-4">
  <div class="card-header fw-bold">上传新版本</div>
  <div class="card-body">
    <%= form_with url: upload_version_document_path(@document), method: :post, multipart: true, local: true do |f| %>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label">版本号</label>
          <input type="text" name="version" class="form-control" placeholder="如: 1.0">
        </div>
        <div class="col-md-4">
          <label class="form-label">选择文件</label>
          <input type="file" name="file" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">变更说明</label>
          <input type="text" name="change_summary" class="form-control" placeholder="本版本变更内容">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">上传</button>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- 版本历史 -->
<div class="card">
  <div class="card-header fw-bold">版本历史</div>
  <div class="card-body">
    <% if @versions.any? %>
      <table class="table table-hover">
        <thead>
          <tr>
            <th>版本</th>
            <th>状态</th>
            <th>上传者</th>
            <th>上传时间</th>
            <th>审批者</th>
            <th>审批时间</th>
            <th>发布时间</th>
            <th>变更说明</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @versions.each do |version| %>
            <tr>
              <td><strong><%= version.version %></strong></td>
              <td><span class="badge bg-<%= version.status == 'released' ? 'success' : 'secondary' %>"><%= version.status_label %></span></td>
              <td><%= version.uploaded_by&.email || '-' %></td>
              <td><%= l(version.created_at, format: :short) if version.created_at %></td>
              <td><%= version.approved_by&.email || '-' %></td>
              <td><%= l(version.approved_at, format: :short) if version.approved_at %></td>
              <td><%= l(version.released_at, format: :short) if version.released_at %></td>
              <td><%= version.change_summary || '-' %></td>
              <td>
                <% if version.file.attached? %>
                  <%= link_to '下载', download_document_path(@document, version_id: version.id), class: 'btn btn-sm btn-outline-primary' %>
                <% end %>
                <% if current_user.admin? || current_user.engineer? %>
                  <% if version.can_submit? %>
                    <%= button_to '提交审批', submit_version_document_path(@document, version_id: version.id), method: :post, class: 'btn btn-sm btn-outline-warning mt-1' %>
                  <% end %>
                  <% if version.can_approve? %>
                    <%= button_to '审批通过', approve_version_document_path(@document, version_id: version.id), method: :post, class: 'btn btn-sm btn-outline-success mt-1' %>
                  <% end %>
                  <% if version.can_release? %>
                    <%= button_to '发布', release_version_document_path(@document, version_id: version.id), method: :post, class: 'btn btn-sm btn-outline-primary mt-1' %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">暂无版本记录</p>
    <% end %>
  </div>
</div>
