<% content_for :title, '新建文档' %>

<div class="page-header mb-4">
  <h1>新建文档</h1>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with model: @document, local: true do |f| %>
      <% if @document.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @document.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :title, '文档标题', class: 'form-label' %>
        <%= f.text_field :title, class: 'form-control', required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :doc_number, '文档编号', class: 'form-label' %>
        <%= f.text_field :doc_number, class: 'form-control', required: true, placeholder: '如: DOC-2026-001' %>
      </div>

      <div class="mb-3">
        <%= f.label :doc_type, '文档类型', class: 'form-label' %>
        <%= f.select :doc_type, Document.doc_types, { include_blank: '请选择' }, class: 'form-select', required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :product_id, '关联产品', class: 'form-label' %>
        <%= f.collection_select :product_id, @products, :id, :name, { include_blank: '不关联' }, class: 'form-select' %>
      </div>

      <div class="mb-3">
        <%= f.label :description, '描述', class: 'form-label' %>
        <%= f.text_area :description, class: 'form-control', rows: 3 %>
      </div>

      <div class="mb-3">
        <%= f.submit '创建', class: 'btn btn-primary' %>
        <%= link_to '取消', documents_path, class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>
