<% content_for :title, "编辑分类: #{@category.name}" %>

<div class="page-header mb-4">
  <h1>编辑分类</h1>
  <%= link_to '返回分类列表', guide_categories_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with model: @category, url: guide_category_path(@category.slug), method: :patch do |f| %>
      <div class="mb-3">
        <label class="form-label">分类名称 *</label>
        <%= f.text_field :name, class: 'form-control', required: true %>
      </div>
      <div class="mb-3">
        <label class="form-label">描述</label>
        <%= f.text_area :description, class: 'form-control', rows: 3 %>
      </div>
      <div class="mb-3">
        <label class="form-label">排序</label>
        <%= f.number_field :sort_order, class: 'form-control' %>
      </div>
      <div class="d-flex gap-2">
        <%= f.submit '保存', class: 'btn btn-primary' %>
        <%= link_to '取消', guide_categories_path, class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>
