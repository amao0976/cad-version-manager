<% content_for :title, '新建变体' %>

<div class="page-header">
  <h1>新建变体</h1>
  <%= link_to '返回列表', product_variants_path(@product), class: 'btn btn-outline-secondary' %>
</div>

<div class="card">
  <div class="card-header fw-bold">变体信息</div>
  <div class="product-info">
    产品：<span><%= @product.name %></span> | 
    编码：<span><%= @product.product_code %></span>
  </div>
  <% if @variant.errors.any? %>
    <div class="alert alert-danger">
      <% @variant.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with model: [@product, @variant], url: product_variants_path(@product), method: :post, data: { turbo: false } do |f| %>
    <div class="mb-3">
      <%= f.label :sku_code, 'SKU编码', class: 'form-label'%>
      <%= f.text_field :sku_code, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :material_id, '材质', class: 'form-label'%>
      <%= f.collection_select :material_id, @materials, :id, :name, { include_blank: '使用产品默认材质' }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :size, '尺寸', class: 'form-label'%>
      <%= f.text_field :size, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :color, '颜色', class: 'form-label'%>
      <%= f.text_field :color, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :gemstone, '宝石', class: 'form-label'%>
      <%= f.text_field :gemstone, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :weight, '重量(g)', class: 'form-label'%>
      <%= f.text_field :weight, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.label :status, '状态', class: 'form-label'%>
      <%= f.select :status, [['启用', 'active'], ['停用', 'inactive']], {}, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= f.label :description, '描述', class: 'form-label'%>
      <%= f.text_area :description, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= f.submit '创建变体', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>