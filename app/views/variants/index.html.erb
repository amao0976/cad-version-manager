<% content_for :title, "#{@product.name} - 变体列表" %>

<div class="page-header">
  <h1><%= @product.name %> - 变体列表</h1>
  <div class="d-flex gap-2 mb-3">
    <%= link_to '返回仪表盘', dashboard_path, class: 'btn btn-danger' %>
    <%= link_to '返回产品', product_path(@product), class: 'btn btn-outline-secondary' %>
    <%= link_to '新建变体', new_product_variant_path(@product), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-bold">变体列表</div>
  <div class="product-info">
    产品：<span><%= @product.name %></span> | 
    编码：<span><%= @product.product_code %></span>
  </div>
  <% if @variants.empty? %>
    <p>暂无变体数据</p>
  <% else %>
    <table class="table table-hover align-middle">
      <tr>
        <th>SKU编码</th>
        <th>材质</th>
        <th>尺寸</th>
        <th>颜色</th>
        <th>宝石</th>
        <th>重量</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
      <% @variants.each do |variant| %>
      <tr>
        <td><%= link_to variant.sku_code, product_variant_path(@product, variant) %></td>
        <td><%= variant.material&.name || '-' %></td>
        <td><%= variant.size || '-' %></td>
        <td><%= variant.color || '-' %></td>
        <td><%= variant.gemstone || '-' %></td>
        <td><%= variant.weight ? "#{variant.weight}g" : '-' %></td>
        <td><span class="status-<%= variant.status %>"><%= case variant.status when 'active' then '启用' when 'inactive' then '停用' end %></span></td>
        <td>
          <%= link_to '查看', product_variant_path(@product, variant), class: 'btn btn-sm' %>
          <%= link_to '编辑', edit_product_variant_path(@product, variant), class: 'btn btn-sm' %>
          <% if variant.status == 'inactive' %>
            <%= link_to '启用', variant_activate_path(variant), method: :post, class: 'btn btn-sm' %>
          <% end %>
          <% if variant.status == 'active' %>
            <%= link_to '停用', variant_deactivate_path(variant), method: :post, class: 'btn btn-sm' %>
          <% end %>
          <%= button_to '删除', product_variant_path(@product, variant), method: :delete, form: { class: 'd-inline' }, data: { turbo_confirm: '确认删除?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
      <% end %>
    </table>
  <% end %>
</div>